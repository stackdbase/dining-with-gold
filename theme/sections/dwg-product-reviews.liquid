{%- liquid
  # ============================================================
  # DWG: Product Reviews — fully owned, fully branded
  # Reviews live in our own backend (Supabase via dwg-reviews-api).
  #   • Display: JS fetches <api_base>/api/list?product=<handle>
  #   • Submit:  form POSTs to <api_base>/api/submit
  # Set the API base URL in this section's settings.
  # ============================================================
  assign s = section.settings
  assign accent = s.accent_color | default: '#C9882A'
  assign dark = s.text_color | default: '#1C1C1C'
  assign cream = s.background_color | default: '#FAF7F2'
  assign card = s.card_color | default: '#FFFFFF'
  assign panel = s.panel_color | default: '#FFFFFF'
  assign panel_text = s.panel_text_color | default: '#1C1C1C'
  assign product = closest.product | default: product
-%}

<section
  class="dwg-reviews"
  id="dwg-reviews-{{ section.id }}"
  data-api-base="{{ s.api_base }}"
  data-product-id="{{ product.id }}"
  data-product-handle="{{ product.handle }}"
  style="
    --dwgr-accent: {{ accent }};
    --dwgr-dark: {{ dark }};
    --dwgr-cream: {{ cream }};
    --dwgr-card: {{ card }};
    --dwgr-panel: {{ panel }};
    --dwgr-panel-text: {{ panel_text }};
  "
>
  <svg class="dwgr-svg-defs" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="dwgr-half-{{ section.id }}" x1="0" x2="100%" y1="0" y2="0">
        <stop offset="50%" stop-color="var(--dwgr-accent)"></stop>
        <stop offset="50%" stop-color="rgba(28,28,28,0.16)"></stop>
      </linearGradient>
      <symbol id="dwgr-star-{{ section.id }}" viewBox="0 0 32 32">
        <path d="M31.547 12a.848.848 0 00-.677-.577l-9.427-1.376-4.224-8.532a.847.847 0 00-1.516 0l-4.218 8.534-9.427 1.355a.847.847 0 00-.467 1.467l6.823 6.664-1.612 9.375a.847.847 0 001.23.893l8.428-4.434 8.432 4.432a.847.847 0 001.229-.894l-1.615-9.373 6.822-6.665a.845.845 0 00.214-.869z"/>
      </symbol>
    </defs>
  </svg>

  <div class="dwg-reviews__inner">
    <header class="dwg-reviews__head">
      {%- if s.eyebrow != blank -%}<p class="dwg-reviews__eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="dwg-reviews__heading">{{ s.heading }}</h2>{%- endif -%}
    </header>

    {%- comment -%} overview panel — filled by JS {%- endcomment -%}
    <div class="dwg-reviews__overview" data-dwgr-summary>
      <p class="dwg-reviews__loading">Loading reviews…</p>
    </div>

    {%- comment -%} review cards — horizontally scrollable, filled by JS {%- endcomment -%}
    <div class="dwg-reviews__list" data-dwgr-list></div>
    <p class="dwg-reviews__scrollhint" data-dwgr-scrollhint hidden>Swipe for more →</p>
  </div>

  {%- comment -%} ---- submit modal ---- {%- endcomment -%}
  {%- if s.show_form -%}
    <div class="dwg-reviews__modal" data-dwgr-modal hidden>
      <div class="dwg-reviews__modal-overlay" data-dwgr-close></div>
      <div class="dwg-reviews__modal-card" role="dialog" aria-modal="true" aria-labelledby="dwgr-form-title-{{ section.id }}">
        <button type="button" class="dwg-reviews__modal-x" data-dwgr-close aria-label="Close">×</button>
        <h3 class="dwg-reviews__form-title" id="dwgr-form-title-{{ section.id }}">{{ s.form_heading | default: 'Write a review' }}</h3>
        <p class="dwg-reviews__form-sub">{{ s.form_subheading | default: 'Share your experience — it only takes a minute.' }}</p>

        <form class="dwg-reviews__form" data-dwgr-form novalidate>
          <div class="dwg-reviews__hp" aria-hidden="true">
            <label>Leave this empty<input type="text" name="company" tabindex="-1" autocomplete="off"></label>
          </div>

          <fieldset class="dwg-reviews__rating-input">
            <legend>Your rating <span class="dwg-reviews__req">*</span></legend>
            <div class="dwg-reviews__star-input" data-dwgr-starinput>
              {%- assign star_order = '5,4,3,2,1' | split: ',' -%}
              {%- for i in star_order -%}
                <input type="radio" id="dwgr-star{{ i }}-{{ section.id }}" name="rating" value="{{ i }}" required>
                <label for="dwgr-star{{ i }}-{{ section.id }}" title="{{ i }} star{% if i != '1' %}s{% endif %}" aria-label="{{ i }} stars">
                  <svg viewBox="0 0 32 32"><use href="#dwgr-star-{{ section.id }}"></use></svg>
                </label>
              {%- endfor -%}
              <span class="dwg-reviews__rating-hint" data-dwgr-ratinghint>Tap a star</span>
            </div>
          </fieldset>

          <div class="dwg-reviews__row">
            <label class="dwg-reviews__field">
              <span>Name <span class="dwg-reviews__req">*</span></span>
              <input type="text" name="author" required maxlength="80" autocomplete="name" placeholder="e.g. Amara O.">
            </label>
            <label class="dwg-reviews__field">
              <span>Location</span>
              <input type="text" name="location" maxlength="80" placeholder="e.g. London, UK">
            </label>
          </div>

          <label class="dwg-reviews__field">
            <span>Headline</span>
            <input type="text" name="title" maxlength="120" placeholder="Sum it up in a few words">
          </label>

          <label class="dwg-reviews__field">
            <span>Your review <span class="dwg-reviews__req">*</span></span>
            <textarea name="body" rows="5" required maxlength="1500" placeholder="What did you love? How do you use it?"></textarea>
          </label>

          <div class="dwg-reviews__field">
            <span>Would you recommend it?</span>
            <div class="dwg-reviews__pills" data-dwgr-recommend>
              <label class="dwg-reviews__pill"><input type="radio" name="recommend" value="yes"><span>👍 Yes</span></label>
              <label class="dwg-reviews__pill"><input type="radio" name="recommend" value="no"><span>👎 No</span></label>
            </div>
          </div>

          <div class="dwg-reviews__uploads">
            <div class="dwg-reviews__upload">
              <span class="dwg-reviews__upload-label">Your photo</span>
              <label class="dwg-reviews__avatar-drop" data-dwgr-avatar-drop>
                <input type="file" accept="image/*" data-dwgr-avatar hidden>
                <span class="dwg-reviews__avatar-preview" data-dwgr-avatar-preview>+</span>
                <span class="dwg-reviews__upload-hint">Optional avatar</span>
              </label>
            </div>

            <div class="dwg-reviews__upload dwg-reviews__upload--photos">
              <span class="dwg-reviews__upload-label">Product photos <em>(up to 4)</em></span>
              <div class="dwg-reviews__photos" data-dwgr-photos>
                <label class="dwg-reviews__photo-add" data-dwgr-photo-add>
                  <input type="file" accept="image/*" multiple data-dwgr-photo-input hidden>
                  <span>＋</span>
                </label>
              </div>
            </div>
          </div>

          <label class="dwg-reviews__field">
            <span>Email <em>(private — not published)</em> <span class="dwg-reviews__req">*</span></span>
            <input type="email" name="email" required maxlength="120" autocomplete="email" placeholder="you@email.com">
          </label>

          {%- if s.turnstile_site_key != blank -%}
            <div class="cf-turnstile dwg-reviews__turnstile" data-sitekey="{{ s.turnstile_site_key }}" data-theme="light"></div>
          {%- endif -%}

          <button type="submit" class="dwg-reviews__submit">{{ s.submit_label | default: 'Submit review' }}</button>
          <p class="dwg-reviews__form-msg" data-dwgr-msg role="status" aria-live="polite"></p>
          <p class="dwg-reviews__form-note">{{ s.form_note | default: 'Your review posts straight to the page.' }}</p>
        </form>
      </div>
    </div>

    {%- comment -%} lightbox for review photos {%- endcomment -%}
    <div class="dwg-reviews__lightbox" data-dwgr-lb hidden>
      <button type="button" class="dwg-reviews__lb-x" data-dwgr-lb-close aria-label="Close">×</button>
      {% # theme-check-disable ImgWidthAndHeight %}
      <img alt="Review photo" data-dwgr-lb-img>
      {% # theme-check-enable ImgWidthAndHeight %}
    </div>
  {%- endif -%}
</section>

{%- if s.turnstile_site_key != blank -%}
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
{%- endif -%}

<script>
  (function () {
    var root = document.getElementById('dwg-reviews-{{ section.id }}');
    if (!root) return;

    var SID = {{ section.id | json }};
    var API_BASE = (root.getAttribute('data-api-base') || '').replace(/\/+$/, '');
    var PRODUCT_HANDLE = root.getAttribute('data-product-handle') || '';
    var PRODUCT_ID = root.getAttribute('data-product-id') || '';
    var PRODUCT_TITLE = {{ product.title | default: '' | json }};
    var INITIAL = {{ s.initial_visible | default: 4 }};
    var EMPTY_TEXT = {{ s.empty_text | default: 'No reviews yet — be the first to share your experience.' | json }};
    var SUCCESS_MSG = {{ s.success_message | default: 'Thank you! Your review is now live.' | json }};
    var DESIGN_MODE = {{ request.design_mode | json }};
    var POOL = {{ s.review_pool | default: 'current' | json }};

    var GOLD = 'var(--dwgr-accent)', EMPTY = 'rgba(28,28,28,0.16)', HALF = 'url(#dwgr-half-' + SID + ')';

    function esc(v) {
      return (v == null ? '' : String(v)).replace(/&/g, '&amp;').replace(/</g, '&lt;')
        .replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
    }
    function br(v) { return esc(v).replace(/\n/g, '<br>'); }
    function initials(name) {
      var p = (name || '').trim().split(/\s+/).filter(Boolean);
      return ((p[0] ? p[0][0] : '') + (p[1] ? p[1][0] : '')).toUpperCase() || '★';
    }
    function star(fill, cls) {
      return '<svg class="dwgr-star' + (cls || '') + '" viewBox="0 0 32 32"><use href="#dwgr-star-' + SID + '" fill="' + fill + '"></use></svg>';
    }
    function starsFor(avg, cls) {
      var out = '', fs = Math.floor(avg), rem = avg - fs;
      for (var i = 1; i <= 5; i++) {
        if (i <= fs) out += star(GOLD, cls);
        else if (i === fs + 1 && rem >= 0.75) out += star(GOLD, cls);
        else if (i === fs + 1 && rem >= 0.25) out += star(HALF, cls);
        else out += star(EMPTY, cls);
      }
      return out;
    }
    function starsInt(n, cls) { var o = ''; for (var i = 1; i <= 5; i++) o += star(i <= n ? GOLD : EMPTY, cls); return o; }
    function fmtDate(iso) { try { return new Date(iso).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' }); } catch (e) { return ''; } }

    var summaryEl = root.querySelector('[data-dwgr-summary]');
    var listEl = root.querySelector('[data-dwgr-list]');
    var scrollHint = root.querySelector('[data-dwgr-scrollhint]');

    function render(data) {
      var count = data.count || 0, avg = data.average || 0;
      if (!count) {
        summaryEl.innerHTML = '<div class="dwg-reviews__empty-wrap"><p class="dwg-reviews__empty">' + esc(EMPTY_TEXT) + '</p>' + writeBtn() + '</div>';
        listEl.innerHTML = ''; if (scrollHint) scrollHint.hidden = true; wireWrite(); return;
      }
      var h = data.histogram || {}, histRows = '';
      [5, 4, 3, 2, 1].forEach(function (n) {
        var rc = h[n] || 0, pct = count ? Math.round((rc * 100) / count) : 0;
        histRows += '<button class="dwg-reviews__hist-row" type="button" tabindex="-1">' +
          '<span class="dwg-reviews__hist-label">' + n + ' ' + star(GOLD, ' dwgr-star--xs') + '</span>' +
          '<span class="dwg-reviews__hist-track"><span class="dwg-reviews__hist-fill" style="width:' + pct + '%"></span></span>' +
          '<span class="dwg-reviews__hist-num">' + rc + '</span></button>';
      });
      var recLine = (data.recommend_pct != null)
        ? '<p class="dwg-reviews__recline"><strong>' + data.recommend_pct + '%</strong> would recommend</p>' : '';

      summaryEl.innerHTML =
        '<div class="dwg-reviews__ov-left">' +
          '<span class="dwg-reviews__avg">' + avg.toFixed(1) + '</span>' +
          '<span class="dwg-reviews__ov-stars">' + starsFor(avg, '') + '</span>' +
          '<span class="dwg-reviews__count">Based on ' + count + (count === 1 ? ' review' : ' reviews') + '</span>' +
          recLine +
        '</div>' +
        '<div class="dwg-reviews__ov-right">' + histRows + '</div>' +
        '<div class="dwg-reviews__ov-cta">' + writeBtn() + '</div>';

      var reviews = data.reviews || [];
      listEl.innerHTML = reviews.map(function (r, idx) {
        var av = r.avatar_url
          ? '<span class="dwg-reviews__avatar" style="background-image:url(' + esc(r.avatar_url) + ')"></span>'
          : '<span class="dwg-reviews__avatar dwg-reviews__avatar--initials">' + esc(initials(r.author)) + '</span>';
        var badges = '';
        if (r.verified_buyer) badges += '<span class="dwg-reviews__verified">✓ Verified</span>';
        if (r.recommend === true) badges += '<span class="dwg-reviews__rec">👍 Recommends</span>';
        var sub = [];
        if (r.country) sub.push(esc(r.country));
        if (r.created_at) sub.push(esc(fmtDate(r.created_at)));
        var imgs = (r.images && r.images.length)
          ? '<div class="dwg-reviews__item-photos">' + r.images.map(function (u) {
              return '<button type="button" class="dwg-reviews__thumb" data-full="' + esc(u) + '"><img src="' + esc(u) + '" loading="lazy" alt="Customer photo"></button>';
            }).join('') + '</div>' : '';
        return '<article class="dwg-reviews__item">' +
            '<div class="dwg-reviews__item-head">' + av +
              '<div class="dwg-reviews__item-who"><span class="dwg-reviews__item-author">' + esc(r.author || 'Verified customer') + '</span>' +
              (sub.length ? '<span class="dwg-reviews__item-sub">' + sub.join(' · ') + '</span>' : '') + '</div>' +
              (badges ? '<div class="dwg-reviews__item-badges">' + badges + '</div>' : '') +
            '</div>' +
            '<div class="dwg-reviews__item-stars">' + starsInt(r.rating, ' dwgr-star--sm') + '</div>' +
            (r.title ? '<p class="dwg-reviews__item-title">' + esc(r.title) + '</p>' : '') +
            (r.body ? '<p class="dwg-reviews__item-body">' + br(r.body) + '</p>' : '') +
            imgs +
          '</article>';
      }).join('');

      if (scrollHint) scrollHint.hidden = reviews.length <= 1;
      wireWrite(); wireThumbs(); injectJsonLd(data);
    }

    function writeBtn() {
      return {{ s.show_form | json }} ? '<button type="button" class="dwg-reviews__write-btn" data-dwgr-open>' + {{ s.form_button_label | default: 'Write a review' | json }} + '</button>' : '';
    }

    function injectJsonLd(data) {
      if (!data.count || !PRODUCT_TITLE) return;
      try {
        var ld = { '@context': 'https://schema.org', '@type': 'Product', name: PRODUCT_TITLE,
          aggregateRating: { '@type': 'AggregateRating', ratingValue: data.average, reviewCount: data.count, bestRating: 5, worstRating: 1 },
          review: (data.reviews || []).slice(0, 20).map(function (r) {
            return { '@type': 'Review', reviewRating: { '@type': 'Rating', ratingValue: r.rating, bestRating: 5, worstRating: 1 },
              author: { '@type': 'Person', name: r.author || 'Verified customer' }, reviewBody: r.body || '', name: r.title || undefined,
              datePublished: r.created_at ? String(r.created_at).slice(0, 10) : undefined }; }) };
        var old = document.querySelector('script[data-dwgr-ld="' + SID + '"]'); if (old) old.remove();
        var el = document.createElement('script'); el.type = 'application/ld+json'; el.setAttribute('data-dwgr-ld', SID);
        el.textContent = JSON.stringify(ld); document.head.appendChild(el);
      } catch (e) {}
    }

    var SAMPLE = { count: 42, average: 4.8, histogram: { 5: 34, 4: 6, 3: 1, 2: 1, 1: 0 }, recommend_pct: 96, reviews: [
      { rating: 5, title: 'Incredible depth of flavour', body: 'A little goes a long way — the gold really shines on everything from eggs to noodles.', author: 'Amara O.', country: 'London, UK', verified_buyer: true, recommend: true, created_at: '2026-06-20', images: [] },
      { rating: 5, title: 'New pantry staple', body: 'Perfect heat and beautifully packaged. Travels well too.', author: 'James P.', country: 'Manchester, UK', verified_buyer: true, recommend: true, created_at: '2026-06-14', images: [] },
      { rating: 4, title: 'Lovely', body: 'Great gift. Would love a larger size.', author: 'Priya S.', country: 'Leeds, UK', verified_buyer: false, recommend: true, created_at: '2026-06-02', images: [] }
    ] };

    function load() {
      if (DESIGN_MODE || !API_BASE) { render(SAMPLE); return; }
      var url = POOL === 'all'
        ? API_BASE + '/api/list?all=1'
        : API_BASE + '/api/list?product=' + encodeURIComponent(PRODUCT_HANDLE) + '&product_id=' + encodeURIComponent(PRODUCT_ID);
      fetch(url, { headers: { Accept: 'application/json' } })
        .then(function (r) { return r.ok ? r.json() : Promise.reject(); })
        .then(render)
        .catch(function () { render({ count: 0 }); });
    }

    // ---- modal ----
    var modal = root.querySelector('[data-dwgr-modal]');
    function open() { if (modal) { modal.hidden = false; document.body.style.overflow = 'hidden'; } }
    function close() { if (modal) { modal.hidden = true; document.body.style.overflow = ''; } }
    function wireWrite() { root.querySelectorAll('[data-dwgr-open]').forEach(function (b) { b.onclick = open; }); }
    root.querySelectorAll('[data-dwgr-close]').forEach(function (b) { b.addEventListener('click', close); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') { close(); lbClose(); } });
    if (modal) { var deep = (location.hash + location.search).toLowerCase();
      if (deep.indexOf('write-a-review') !== -1 || deep.indexOf('leave-review') !== -1) { setTimeout(open, 300); try { root.scrollIntoView({ behavior: 'smooth', block: 'start' }); } catch (e) {} } }

    // ---- lightbox ----
    var lb = root.querySelector('[data-dwgr-lb]'), lbImg = root.querySelector('[data-dwgr-lb-img]');
    function lbClose() { if (lb) { lb.hidden = true; } }
    if (lb) { root.querySelectorAll('[data-dwgr-lb-close]').forEach(function (b) { b.addEventListener('click', lbClose); });
      lb.addEventListener('click', function (e) { if (e.target === lb) lbClose(); }); }
    function wireThumbs() { root.querySelectorAll('[data-full]').forEach(function (t) { t.onclick = function () { if (lbImg) { lbImg.src = t.getAttribute('data-full'); lb.hidden = false; } }; }); }

    // ---- star rating hint ----
    var starInput = root.querySelector('[data-dwgr-starinput]');
    if (starInput) { var hint = starInput.querySelector('[data-dwgr-ratinghint]');
      starInput.addEventListener('change', function (e) { if (e.target.name === 'rating' && hint) hint.textContent = e.target.value + ' / 5'; }); }

    // ---- image handling (client-side resize) ----
    function resizeImage(file, maxDim, quality) {
      return new Promise(function (resolve, reject) {
        if (!file || !/^image\//.test(file.type)) return reject();
        var reader = new FileReader();
        reader.onload = function (e) {
          var img = new Image();
          img.onload = function () {
            var w = img.width, h = img.height;
            if (w > h && w > maxDim) { h = Math.round(h * maxDim / w); w = maxDim; }
            else if (h > maxDim) { w = Math.round(w * maxDim / h); h = maxDim; }
            var c = document.createElement('canvas'); c.width = w; c.height = h;
            c.getContext('2d').drawImage(img, 0, 0, w, h);
            resolve(c.toDataURL('image/jpeg', quality));
          };
          img.onerror = reject; img.src = e.target.result;
        };
        reader.onerror = reject; reader.readAsDataURL(file);
      });
    }

    var avatarData = null, photosData = [];
    var avatarInput = root.querySelector('[data-dwgr-avatar]');
    var avatarPreview = root.querySelector('[data-dwgr-avatar-preview]');
    if (avatarInput) avatarInput.addEventListener('change', function () {
      var f = avatarInput.files[0]; if (!f) return;
      resizeImage(f, 400, 0.85).then(function (d) { avatarData = d;
        avatarPreview.textContent = ''; avatarPreview.style.backgroundImage = 'url(' + d + ')'; avatarPreview.classList.add('has-img');
      }).catch(function () {});
    });

    var photoInput = root.querySelector('[data-dwgr-photo-input]');
    var photosWrap = root.querySelector('[data-dwgr-photos]');
    var photoAdd = root.querySelector('[data-dwgr-photo-add]');
    function renderPhotos() {
      photosWrap.querySelectorAll('.dwg-reviews__photo-thumb').forEach(function (n) { n.remove(); });
      photosData.forEach(function (d, i) {
        var b = document.createElement('span'); b.className = 'dwg-reviews__photo-thumb'; b.style.backgroundImage = 'url(' + d + ')';
        var x = document.createElement('button'); x.type = 'button'; x.className = 'dwg-reviews__photo-rm'; x.textContent = '×';
        x.onclick = function () { photosData.splice(i, 1); renderPhotos(); };
        b.appendChild(x); photosWrap.insertBefore(b, photoAdd);
      });
      photoAdd.style.display = photosData.length >= 4 ? 'none' : '';
    }
    if (photoInput) photoInput.addEventListener('change', function () {
      var files = Array.prototype.slice.call(photoInput.files, 0, 4 - photosData.length);
      Promise.all(files.map(function (f) { return resizeImage(f, 1100, 0.8).catch(function () { return null; }); }))
        .then(function (arr) { arr.filter(Boolean).forEach(function (d) { if (photosData.length < 4) photosData.push(d); }); renderPhotos(); photoInput.value = ''; });
    });

    // ---- submit ----
    var form = root.querySelector('[data-dwgr-form]');
    if (form) {
      var msg = form.querySelector('[data-dwgr-msg]');
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        msg.className = 'dwg-reviews__form-msg'; msg.textContent = '';
        if (form.company && form.company.value) return;
        if (!form.rating.value) { msg.textContent = 'Please choose a star rating.'; msg.classList.add('is-error'); return; }
        var tsEl = form.querySelector('[name="cf-turnstile-response"]');
        if (root.querySelector('.cf-turnstile') && (!tsEl || !tsEl.value)) { msg.textContent = 'Please complete the verification.'; msg.classList.add('is-error'); return; }
        if (!API_BASE) { msg.textContent = 'Reviews aren’t configured yet.'; msg.classList.add('is-error'); return; }

        var btn = form.querySelector('.dwg-reviews__submit'); btn.disabled = true; var original = btn.textContent; btn.textContent = 'Sending…';
        var rec = form.querySelector('[name="recommend"]:checked');
        fetch(API_BASE + '/api/submit', {
          method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            product_id: PRODUCT_ID, product_handle: PRODUCT_HANDLE, rating: form.rating.value,
            author: form.author.value, email: form.email.value, title: form.title.value, body: form.body.value,
            location: form.location ? form.location.value : '', recommend: rec ? rec.value : null,
            avatar: avatarData, images: photosData, turnstile_token: tsEl ? tsEl.value : ''
          })
        }).then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); })
          .then(function (res) {
            if (res.ok) { form.reset(); avatarData = null; photosData = []; renderPhotos();
              if (avatarPreview) { avatarPreview.style.backgroundImage = ''; avatarPreview.textContent = '+'; avatarPreview.classList.remove('has-img'); }
              msg.textContent = SUCCESS_MSG; msg.classList.add('is-success'); btn.textContent = 'Submitted ✓';
              setTimeout(function () { close(); load(); btn.disabled = false; btn.textContent = original; }, 1400);
            } else { msg.textContent = (res.d && res.d.error) || 'Something went wrong. Please try again.'; msg.classList.add('is-error'); btn.disabled = false; btn.textContent = original; }
          }).catch(function () { msg.textContent = 'Network error. Please try again.'; msg.classList.add('is-error'); btn.disabled = false; btn.textContent = original; });
      });
    }

    load();
  })();
</script>

{% stylesheet %}
  .dwg-reviews { background: linear-gradient(180deg, var(--dwgr-cream) 0%, #F1E7D3 100%); color: var(--dwgr-dark); padding-block: clamp(34px, 4vw, 60px); }
  .dwg-reviews__inner { max-width: 1080px; margin: 0 auto; padding-inline: clamp(18px, 5vw, 44px); }
  .dwgr-svg-defs { position: absolute; width: 0; height: 0; }
  .dwgr-star { width: 1.15em; height: 1.15em; display: inline-block; vertical-align: middle; }
  .dwgr-star--sm { width: 0.95em; height: 0.95em; }
  .dwgr-star--xs { width: 0.72em; height: 0.72em; }

  .dwg-reviews__head { text-align: center; margin-bottom: clamp(16px, 2.2vw, 24px); }
  .dwg-reviews__eyebrow { margin: 0 0 10px; font-size: 0.74rem; font-weight: 700; letter-spacing: 0.24em; text-transform: uppercase; color: var(--dwgr-accent); }
  .dwg-reviews__heading { margin: 0; font-family: var(--font-heading--family, serif); font-size: clamp(1.9rem, 4vw, 2.9rem); line-height: 1.08; color: var(--dwgr-dark); }
  .dwg-reviews__heading::after { content: ""; display: block; width: 44px; height: 3px; border-radius: 3px; background: var(--dwgr-accent); margin: 11px auto 0; }
  .dwg-reviews__loading { opacity: 0.5; text-align: center; padding: 30px 0; }

  /* ---- overview panel ---- */
  .dwg-reviews__overview {
    display: grid; grid-template-columns: minmax(180px, 1fr) minmax(220px, 1.4fr) auto;
    gap: clamp(16px, 3vw, 30px); align-items: center;
    background: var(--dwgr-panel); color: var(--dwgr-panel-text);
    border: 1px solid rgba(201,136,42,0.28); border-top: 4px solid var(--dwgr-accent); border-radius: 18px;
    padding: clamp(20px, 2.8vw, 32px); margin-bottom: clamp(18px, 2.6vw, 28px);
    box-shadow: 0 16px 38px rgba(201,136,42,0.12);
  }
  .dwg-reviews__ov-left { display: flex; flex-direction: column; align-items: flex-start; gap: 6px; }
  .dwg-reviews__avg { font-family: var(--font-heading--family, serif); font-size: clamp(2.6rem, 5vw, 3.6rem); line-height: 0.95; font-weight: 700; color: var(--dwgr-accent); }
  .dwg-reviews__ov-stars { font-size: 1.35rem; color: var(--dwgr-accent); }
  .dwg-reviews__count { font-size: 0.9rem; color: var(--dwgr-panel-text); opacity: 0.7; }
  .dwg-reviews__recline { margin: 6px 0 0; font-size: 0.9rem; color: var(--dwgr-panel-text); opacity: 0.85; }
  .dwg-reviews__recline strong { color: var(--dwgr-accent); }

  .dwg-reviews__ov-right { display: grid; gap: 8px; }
  .dwg-reviews__hist-row { display: grid; grid-template-columns: 42px 1fr 30px; align-items: center; gap: 12px; background: none; border: none; padding: 0; cursor: default; font: inherit; color: var(--dwgr-panel-text); }
  .dwg-reviews__hist-label { display: inline-flex; align-items: center; gap: 3px; font-size: 0.8rem; opacity: 0.9; color: var(--dwgr-accent); }
  .dwg-reviews__hist-track { height: 9px; border-radius: 999px; background: rgba(28,28,28,0.1); overflow: hidden; }
  .dwg-reviews__hist-fill { display: block; height: 100%; border-radius: 999px; background: var(--dwgr-accent); transition: width .5s ease; }
  .dwg-reviews__hist-num { font-size: 0.8rem; opacity: 0.6; text-align: right; font-variant-numeric: tabular-nums; }
  .dwg-reviews__ov-cta { display: flex; justify-content: center; }

  .dwg-reviews__empty-wrap { text-align: center; padding: 8px 0; }
  .dwg-reviews__empty { font-size: 1.05rem; color: var(--dwgr-panel-text); opacity: 0.85; margin: 0 0 20px; }

  .dwg-reviews__write-btn, .dwg-reviews__submit {
    display: inline-flex; align-items: center; justify-content: center; padding: 15px 32px; border-radius: 12px; border: none;
    background: var(--dwgr-accent); color: #fff; font-family: var(--font-body--family, sans-serif);
    font-size: 0.8rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; cursor: pointer;
    transition: transform .15s ease, background-color .15s ease, box-shadow .15s ease; box-shadow: 0 8px 20px rgba(201,136,42,0.28);
  }
  .dwg-reviews__write-btn:hover, .dwg-reviews__submit:hover { background: #b07623; transform: translateY(-2px); box-shadow: 0 12px 26px rgba(201,136,42,0.34); }
  .dwg-reviews__submit:disabled { opacity: 0.65; cursor: default; transform: none; box-shadow: none; }

  /* ---- review cards grid ---- */
  .dwg-reviews__list { display: flex; gap: 14px; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 12px; margin-inline: calc(clamp(18px, 5vw, 44px) * -1); padding-inline: clamp(18px, 5vw, 44px); -webkit-overflow-scrolling: touch; scrollbar-width: thin; }
  .dwg-reviews__list::-webkit-scrollbar { height: 6px; }
  .dwg-reviews__list::-webkit-scrollbar-thumb { background: rgba(28,28,28,0.18); border-radius: 999px; }
  .dwg-reviews__item { flex: 0 0 clamp(290px, 84vw, 384px); scroll-snap-align: start; background: var(--dwgr-card); border: 1px solid rgba(201,136,42,0.16); border-top: 3px solid var(--dwgr-accent); border-radius: 16px; padding: 22px; box-shadow: 0 10px 26px rgba(28,28,28,0.06); transition: transform .18s ease, box-shadow .18s ease; }
  .dwg-reviews__item:hover { transform: translateY(-2px); box-shadow: 0 16px 34px rgba(201,136,42,0.14); }
  .dwg-reviews__item-head { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 12px; margin-bottom: 14px; }
  .dwg-reviews__avatar { width: 46px; height: 46px; border-radius: 50%; background-size: cover; background-position: center; flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center; }
  .dwg-reviews__avatar--initials { background: linear-gradient(135deg, var(--dwgr-accent), #b07623); color: #fff; font-weight: 700; font-size: 0.95rem; }
  .dwg-reviews__item-who { display: flex; flex-direction: column; min-width: 0; }
  .dwg-reviews__item-author { font-weight: 700; font-size: 0.98rem; color: var(--dwgr-dark); }
  .dwg-reviews__item-sub { font-size: 0.78rem; opacity: 0.55; }
  .dwg-reviews__item-badges { display: flex; flex-direction: column; gap: 4px; align-items: flex-end; }
  .dwg-reviews__verified, .dwg-reviews__rec { font-size: 0.68rem; font-weight: 700; white-space: nowrap; padding: 3px 8px; border-radius: 999px; }
  .dwg-reviews__verified { color: var(--dwgr-accent); background: rgba(201,136,42,0.1); }
  .dwg-reviews__rec { color: #2f7d4f; background: rgba(47,125,79,0.1); }
  .dwg-reviews__item-stars { color: var(--dwgr-accent); font-size: 1.05rem; margin-bottom: 8px; }
  .dwg-reviews__item-title { margin: 0 0 6px; font-family: var(--font-heading--family, serif); font-size: 1.12rem; font-weight: 700; color: var(--dwgr-dark); }
  .dwg-reviews__item-body { margin: 0; font-size: 0.95rem; line-height: 1.6; color: var(--dwgr-dark); opacity: 0.88; }
  .dwg-reviews__item-photos { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
  .dwg-reviews__thumb { width: 70px; height: 70px; border-radius: 10px; overflow: hidden; border: 1px solid rgba(28,28,28,0.1); padding: 0; cursor: zoom-in; background: none; }
  .dwg-reviews__thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .dwg-reviews__scrollhint { text-align: right; margin: 8px 2px 0; font-size: 0.74rem; opacity: 0.45; }

  /* ---- modal / form ---- */
  .dwg-reviews__modal { position: fixed; inset: 0; z-index: 9999; display: flex; align-items: center; justify-content: center; padding: 18px; }
  .dwg-reviews__modal[hidden] { display: none; }
  .dwg-reviews__modal-overlay { position: absolute; inset: 0; background: rgba(28,28,28,0.55); backdrop-filter: blur(3px); }
  .dwg-reviews__modal-card { position: relative; background: var(--dwgr-card); border-radius: 20px; padding: clamp(24px, 4vw, 40px); width: 100%; max-width: 540px; max-height: 92vh; overflow-y: auto; box-shadow: 0 30px 70px rgba(28,28,28,0.32); }
  .dwg-reviews__modal-x { position: absolute; top: 14px; right: 16px; background: none; border: none; font-size: 1.8rem; line-height: 1; color: var(--dwgr-dark); opacity: 0.5; cursor: pointer; }
  .dwg-reviews__modal-x:hover { opacity: 1; }
  .dwg-reviews__form-title { margin: 0 0 4px; font-family: var(--font-heading--family, serif); font-size: 1.6rem; color: var(--dwgr-dark); }
  .dwg-reviews__form-sub { margin: 0 0 22px; font-size: 0.9rem; opacity: 0.6; }
  .dwg-reviews__req { color: var(--dwgr-accent); }
  .dwg-reviews__hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

  .dwg-reviews__rating-input { border: none; padding: 0; margin: 0 0 18px; }
  .dwg-reviews__rating-input legend { padding: 0; margin-bottom: 8px; font-size: 0.85rem; font-weight: 700; color: var(--dwgr-dark); }
  .dwg-reviews__star-input { display: flex; flex-direction: row-reverse; justify-content: flex-end; align-items: center; gap: 6px; }
  .dwg-reviews__star-input input { position: absolute; width: 1px; height: 1px; opacity: 0; }
  .dwg-reviews__star-input label { cursor: pointer; line-height: 0; color: rgba(28,28,28,0.18); transition: color .12s ease, transform .12s ease; }
  .dwg-reviews__star-input label svg { width: 36px; height: 36px; fill: currentColor; display: block; }
  .dwg-reviews__star-input label:hover { transform: scale(1.12); }
  .dwg-reviews__star-input input:checked ~ label,
  .dwg-reviews__star-input label:hover,
  .dwg-reviews__star-input label:hover ~ label { color: var(--dwgr-accent); }
  .dwg-reviews__star-input input:focus-visible + label { outline: 2px solid var(--dwgr-accent); outline-offset: 3px; border-radius: 4px; }
  .dwg-reviews__rating-hint { order: 10; margin-left: 12px; font-size: 0.82rem; opacity: 0.55; }

  .dwg-reviews__row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .dwg-reviews__field { display: block; margin-bottom: 16px; }
  .dwg-reviews__field > span { display: block; margin-bottom: 6px; font-size: 0.85rem; font-weight: 700; color: var(--dwgr-dark); }
  .dwg-reviews__field em { font-weight: 400; opacity: 0.55; font-style: normal; }
  .dwg-reviews__field input, .dwg-reviews__field textarea {
    width: 100%; padding: 12px 14px; border: 1px solid rgba(28,28,28,0.2); border-radius: 10px; background: #fff; color: var(--dwgr-dark);
    font-family: var(--font-body--family, sans-serif); font-size: 0.95rem;
  }
  .dwg-reviews__field input:focus, .dwg-reviews__field textarea:focus { outline: none; border-color: var(--dwgr-accent); box-shadow: 0 0 0 3px rgba(201,136,42,0.18); }

  .dwg-reviews__pills { display: flex; gap: 10px; }
  .dwg-reviews__pill { position: relative; }
  .dwg-reviews__pill input { position: absolute; opacity: 0; inset: 0; cursor: pointer; }
  .dwg-reviews__pill span { display: inline-flex; padding: 9px 18px; border-radius: 999px; border: 1.5px solid rgba(28,28,28,0.2); font-size: 0.85rem; font-weight: 600; transition: all .12s ease; }
  .dwg-reviews__pill input:checked + span { border-color: var(--dwgr-accent); background: rgba(201,136,42,0.12); color: var(--dwgr-accent); }

  .dwg-reviews__uploads { display: grid; grid-template-columns: auto 1fr; gap: 18px; margin-bottom: 18px; align-items: start; }
  .dwg-reviews__upload-label { display: block; margin-bottom: 8px; font-size: 0.85rem; font-weight: 700; color: var(--dwgr-dark); }
  .dwg-reviews__upload-label em { font-weight: 400; opacity: 0.55; font-style: normal; }
  .dwg-reviews__avatar-drop { display: flex; flex-direction: column; align-items: center; gap: 6px; cursor: pointer; }
  .dwg-reviews__avatar-preview { width: 64px; height: 64px; border-radius: 50%; border: 2px dashed rgba(28,28,28,0.25); display: flex; align-items: center; justify-content: center; font-size: 1.4rem; color: rgba(28,28,28,0.4); background-size: cover; background-position: center; }
  .dwg-reviews__avatar-preview.has-img { border-style: solid; border-color: var(--dwgr-accent); }
  .dwg-reviews__upload-hint { font-size: 0.7rem; opacity: 0.5; }
  .dwg-reviews__photos { display: flex; flex-wrap: wrap; gap: 8px; }
  .dwg-reviews__photo-add, .dwg-reviews__photo-thumb { width: 64px; height: 64px; border-radius: 10px; position: relative; }
  .dwg-reviews__photo-add { display: flex; align-items: center; justify-content: center; border: 2px dashed rgba(28,28,28,0.25); cursor: pointer; color: rgba(28,28,28,0.4); font-size: 1.4rem; }
  .dwg-reviews__photo-thumb { background-size: cover; background-position: center; border: 1px solid rgba(28,28,28,0.12); }
  .dwg-reviews__photo-rm { position: absolute; top: -7px; right: -7px; width: 20px; height: 20px; border-radius: 50%; border: none; background: #1c1c1c; color: #fff; font-size: 0.85rem; line-height: 1; cursor: pointer; }

  .dwg-reviews__turnstile { margin-bottom: 14px; }
  .dwg-reviews__submit { width: 100%; margin-top: 4px; }
  .dwg-reviews__form-msg { margin: 12px 0 0; font-size: 0.9rem; min-height: 1.2em; }
  .dwg-reviews__form-msg.is-success { color: #2f7d4f; }
  .dwg-reviews__form-msg.is-error { color: #c0392b; }
  .dwg-reviews__form-note { margin: 10px 0 0; font-size: 0.78rem; opacity: 0.55; }

  /* ---- lightbox ---- */
  .dwg-reviews__lightbox { position: fixed; inset: 0; z-index: 10000; background: rgba(15,15,15,0.9); display: flex; align-items: center; justify-content: center; padding: 24px; }
  .dwg-reviews__lightbox[hidden] { display: none; }
  .dwg-reviews__lightbox img { max-width: 92vw; max-height: 88vh; border-radius: 12px; box-shadow: 0 20px 60px rgba(0,0,0,0.5); }
  .dwg-reviews__lb-x { position: absolute; top: 20px; right: 24px; background: none; border: none; color: #fff; font-size: 2.2rem; line-height: 1; cursor: pointer; opacity: 0.85; }

  @media screen and (max-width: 820px) {
    .dwg-reviews__overview { grid-template-columns: 1fr; text-align: center; }
    .dwg-reviews__ov-left { align-items: center; }
    .dwg-reviews__ov-cta { justify-content: center; }
  }
  @media screen and (max-width: 560px) {
    .dwg-reviews__list { grid-template-columns: 1fr; }
    .dwg-reviews__row { grid-template-columns: 1fr; }
    .dwg-reviews__uploads { grid-template-columns: 1fr; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "DWG: Product Reviews",
  "tag": "section",
  "class": "section--dwg-reviews",
  "settings": [
    { "type": "paragraph", "content": "Reviews are stored in the DWG reviews backend (Supabase). Set the API base URL below." },
    { "type": "text", "id": "api_base", "label": "API base URL", "info": "e.g. https://dwg-reviews-api.vercel.app (no trailing slash)." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "LOVED BY YOU" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What our customers say" },
    { "type": "text", "id": "empty_text", "label": "Empty state text", "default": "No reviews yet — be the first to share your experience." },
    { "type": "header", "content": "Display" },
    { "type": "select", "id": "review_pool", "label": "Which reviews to show", "options": [ { "value": "current", "label": "This product only" }, { "value": "all", "label": "All reviews (shared across pages)" } ], "default": "current", "info": "Use 'All' for a single-product store so every page shows the same reviews." },
    { "type": "range", "id": "initial_visible", "label": "Reviews shown before 'Show all'", "min": 2, "max": 24, "step": 1, "default": 4 },
    { "type": "text", "id": "show_more_label", "label": "Show-all button label", "default": "Show all reviews" },
    { "type": "header", "content": "Submission form" },
    { "type": "checkbox", "id": "show_form", "label": "Enable Write-a-review form", "default": true },
    { "type": "text", "id": "form_button_label", "label": "Open-form button label", "default": "Write a review" },
    { "type": "text", "id": "form_heading", "label": "Form heading", "default": "Write a review" },
    { "type": "text", "id": "form_subheading", "label": "Form subheading", "default": "Share your experience — it only takes a minute." },
    { "type": "text", "id": "submit_label", "label": "Submit button label", "default": "Submit review" },
    { "type": "text", "id": "turnstile_site_key", "label": "Cloudflare Turnstile site key", "info": "Optional anti-spam. Leave blank to disable." },
    { "type": "text", "id": "success_message", "label": "Success message", "default": "Thank you! Your review has been submitted — it’ll appear shortly once approved." },
    { "type": "text", "id": "form_note", "label": "Form footnote", "default": "Reviews are checked before they appear." },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "accent_color", "label": "Accent (stars / buttons)", "default": "#C9882A" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1C1C1C" },
    { "type": "color", "id": "background_color", "label": "Section background", "default": "#FAF7F2" },
    { "type": "color", "id": "card_color", "label": "Card background", "default": "#FFFFFF" },
    { "type": "color", "id": "panel_color", "label": "Rating panel background", "default": "#FFFFFF" },
    { "type": "color", "id": "panel_text_color", "label": "Rating panel text", "default": "#1C1C1C" }
  ],
  "presets": [ { "name": "DWG: Product Reviews", "category": "Product" } ]
}
{% endschema %}
