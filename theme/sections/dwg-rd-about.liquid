{% comment %}
  DWG redesign — About page. Editorial rows:
  - "cover" split rows: full-bleed edge photo on one side, text on the other
  - "contain" split rows: floating product image on white
  - centered rows: no image, centered text
  Gold headings on image rows, dark headings on centered rows.
  Used by the page.about template. Remove that ref to revert.
{% endcomment %}

{% liquid
  assign bg = section.settings.background | default: '#FFFFFF'
  assign gold = section.settings.heading_color | default: '#A67C1E'
  assign text_color = section.settings.text_color | default: '#1C1C1C'
  assign btn_bg = section.settings.button_background | default: '#A67C1E'
  assign btn_text = section.settings.button_text_color | default: '#FFFFFF'
%}

<section
  class="dwg-rd-about"
  style="--rd-ab-bg: {{ bg }}; --rd-ab-gold: {{ gold }}; --rd-ab-text: {{ text_color }}; --rd-ab-btn-bg: {{ btn_bg }}; --rd-ab-btn-text: {{ btn_text }};"
>
  {% for block in section.blocks %}
    {% liquid
      assign side = block.settings.image_position | default: 'none'
      assign mstyle = block.settings.media_style | default: 'cover'
      assign has_image = false
      if side != 'none'
        if block.settings.image != blank or block.settings.fallback_image != blank
          assign has_image = true
        endif
      endif
    %}

    {% if has_image %}
      <div class="dwg-rd-about__row dwg-rd-about__row--split dwg-rd-about__row--{{ mstyle }} dwg-rd-about__row--img-{{ side }}" {{ block.shopify_attributes }}>
        <div class="dwg-rd-about__media">
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 1200 | image_tag: class: 'dwg-rd-about__img', widths: '500, 800, 1200', loading: 'lazy', alt: block.settings.heading }}
          {% else %}
            <img class="dwg-rd-about__img" src="{{ block.settings.fallback_image | asset_url }}" alt="{{ block.settings.heading }}" width="900" height="1000" loading="lazy">
          {% endif %}
        </div>
        <div class="dwg-rd-about__content">
          {% render 'dwg-rd-about-text', block: block %}
        </div>
      </div>
    {% else %}
      <div class="dwg-rd-about__row dwg-rd-about__row--centered" {{ block.shopify_attributes }}>
        <div class="dwg-rd-about__content">
          {% render 'dwg-rd-about-text', block: block %}
        </div>
      </div>
    {% endif %}
  {% endfor %}
</section>

{% stylesheet %}
  .dwg-rd-about { background: var(--rd-ab-bg); }

  .dwg-rd-about__content { min-width: 0; }

  /* ---- Centered text rows ---- */
  .dwg-rd-about__row--centered {
    max-width: 860px;
    margin-inline: auto;
    text-align: center;
    padding: clamp(40px, 6vw, 80px) clamp(20px, 5vw, 48px);
  }
  .dwg-rd-about__row--centered .dwg-rd-about__body { margin-inline: auto; }

  /* ---- Split rows (base = stacked on mobile) ---- */
  .dwg-rd-about__row--split {
    display: grid;
    grid-template-columns: 1fr;
  }
  .dwg-rd-about__row--split .dwg-rd-about__content {
    padding: clamp(28px, 6vw, 44px) clamp(20px, 5vw, 48px);
    align-self: center;
  }

  .dwg-rd-about__img { display: block; }

  /* Cover style — full-bleed edge photo */
  .dwg-rd-about__row--cover .dwg-rd-about__media { overflow: hidden; min-height: clamp(300px, 70vw, 380px); }
  .dwg-rd-about__row--cover .dwg-rd-about__img { width: 100%; height: 100%; object-fit: cover; }

  /* Contain style — floating product image */
  .dwg-rd-about__row--contain .dwg-rd-about__media {
    display: flex; align-items: center; justify-content: center;
    padding: clamp(20px, 4vw, 40px);
  }
  .dwg-rd-about__row--contain .dwg-rd-about__img {
    width: auto; max-width: 88%; height: auto; max-height: 460px; object-fit: contain;
    filter: drop-shadow(0 20px 44px rgba(0,0,0,0.16));
  }

  @media screen and (min-width: 850px) {
    .dwg-rd-about__row--split { grid-template-columns: 1fr 1fr; align-items: stretch; }

    /* Cover rows go full width; text keeps the page gutter, image bleeds to the edge */
    .dwg-rd-about__row--cover .dwg-rd-about__media { min-height: 100%; }
    .dwg-rd-about__row--cover.dwg-rd-about__row--img-left .dwg-rd-about__media { order: 1; }
    .dwg-rd-about__row--cover.dwg-rd-about__row--img-left .dwg-rd-about__content {
      order: 2;
      padding-right: max(clamp(20px, 5vw, 48px), calc((100vw - var(--dwg-page-max, 1360px)) / 2 + 48px));
      padding-left: clamp(32px, 4vw, 64px);
    }
    .dwg-rd-about__row--cover.dwg-rd-about__row--img-right .dwg-rd-about__media { order: 2; }
    .dwg-rd-about__row--cover.dwg-rd-about__row--img-right .dwg-rd-about__content {
      order: 1;
      padding-left: max(clamp(20px, 5vw, 48px), calc((100vw - var(--dwg-page-max, 1360px)) / 2 + 48px));
      padding-right: clamp(32px, 4vw, 64px);
    }

    /* Contain rows stay within the page width */
    .dwg-rd-about__row--contain {
      max-width: var(--dwg-page-max, 1360px);
      margin-inline: auto;
      padding-inline: clamp(20px, 5vw, 48px);
      align-items: center;
    }
    .dwg-rd-about__row--contain.dwg-rd-about__row--img-right .dwg-rd-about__media { order: 2; }
    .dwg-rd-about__row--contain.dwg-rd-about__row--img-right .dwg-rd-about__content { order: 1; }
  }

  /* ---- Typography ---- */
  .dwg-rd-about__eyebrow {
    font-family: 'Inter', sans-serif; font-weight: 700; letter-spacing: 0.1em;
    text-transform: uppercase; font-size: 0.8rem; color: var(--rd-ab-gold); margin: 0 0 16px;
  }
  .dwg-rd-about__heading {
    font-family: 'Outfit', sans-serif; font-weight: 800; text-transform: uppercase;
    line-height: 1.02; font-size: clamp(1.7rem, 3.4vw, 2.6rem); color: var(--rd-ab-gold); margin: 0 0 14px;
  }
  .dwg-rd-about__row--centered .dwg-rd-about__heading { color: var(--rd-ab-text); }
  .dwg-rd-about__subheading {
    font-family: 'Outfit', sans-serif; font-weight: 700; font-size: clamp(1rem, 1.6vw, 1.2rem);
    color: var(--rd-ab-gold); margin: 0 0 16px;
  }
  .dwg-rd-about__body {
    font-family: 'Manjari', sans-serif; font-size: clamp(0.95rem, 1.3vw, 1.05rem);
    line-height: 1.6; color: rgba(28,28,28,0.82); max-width: 46ch;
  }
  .dwg-rd-about__row--centered .dwg-rd-about__body { max-width: 62ch; }
  .dwg-rd-about__btn {
    display: inline-flex; align-items: center; justify-content: center; margin-top: 22px;
    font-family: 'Manjari', sans-serif; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.04em; font-size: 1rem; padding: 13px 44px;
    background: var(--rd-ab-btn-bg); color: var(--rd-ab-btn-text); text-decoration: none;
    transition: filter 0.2s ease;
  }
  .dwg-rd-about__btn:hover { filter: brightness(1.08); }
{% endstylesheet %}

{% schema %}
{
  "name": "DWG RD: About",
  "settings": [
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "heading_color", "label": "Gold heading/eyebrow", "default": "#A67C1E" },
    { "type": "color", "id": "text_color", "label": "Text / dark heading", "default": "#1C1C1C" },
    { "type": "color", "id": "button_background", "label": "Button", "default": "#A67C1E" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#FFFFFF" }
  ],
  "blocks": [
    {
      "type": "story",
      "name": "Story block",
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "text", "id": "subheading", "label": "Subheading" },
        { "type": "richtext", "id": "body", "label": "Body" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "fallback_image", "label": "Fallback image asset" },
        { "type": "select", "id": "image_position", "label": "Image position", "options": [ { "value": "none", "label": "No image (centered)" }, { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ], "default": "none" },
        { "type": "select", "id": "media_style", "label": "Image style", "options": [ { "value": "cover", "label": "Cover (full-bleed photo)" }, { "value": "contain", "label": "Contain (floating product)" } ], "default": "cover" },
        { "type": "text", "id": "button_label", "label": "Button label" },
        { "type": "url", "id": "button_url", "label": "Button URL" }
      ]
    }
  ],
  "presets": [{ "name": "DWG RD: About" }]
}
{% endschema %}
