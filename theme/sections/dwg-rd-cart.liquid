{% comment %}
  DWG redesign — Cart page. Matches Figma cart screen: product line(s),
  price, MOVE TO PAYMENT (-> Shopify checkout), REMOVE. Real cart.
  Used by the cart template. Remove that template ref to revert.
{% endcomment %}

{% liquid
  assign bg = section.settings.background | default: '#FFFFFF'
  assign eyebrow_color = section.settings.eyebrow_color | default: '#B28100'
  assign text_color = section.settings.text_color | default: '#1C1C1C'
  assign btn_bg = section.settings.button_background | default: '#A97E0C'
  assign btn_text = section.settings.button_text_color | default: '#FFFFFF'
%}

<section
  class="dwg-rd-cart"
  style="--rd-ct-bg: {{ bg }}; --rd-ct-eyebrow: {{ eyebrow_color }}; --rd-ct-text: {{ text_color }}; --rd-ct-btn-bg: {{ btn_bg }}; --rd-ct-btn-text: {{ btn_text }};"
>
  <div class="dwg-rd-cart__wrap page-width">
    {% if cart.item_count > 0 %}
      <form action="{{ routes.cart_url }}" method="post" class="dwg-rd-cart__form">
        <ul class="dwg-rd-cart__list">
          {% for item in cart.items %}
            {% liquid
              assign t = item.product.title | downcase
              assign design_img = ''
              if section.settings.use_design_images
                if t contains 'jar'
                  assign design_img = 'dwg-rd-shop-jar.png'
                elsif t contains '3 pack' or t contains '3-pack' or t contains 'triple' or t contains 'trio' or t contains 'three' or t contains 'bundle'
                  assign design_img = 'dwg-rd-shop-trio.png'
                elsif t contains 'pack' or t contains 'double' or t contains 'duo' or t contains 'twin' or t contains '2 pack'
                  assign design_img = 'dwg-rd-shop-pack.png'
                else
                  assign design_img = 'dwg-rd-shop-bottle.png'
                endif
              endif
            %}
            <li class="dwg-rd-cart__item">
              <a class="dwg-rd-cart__media" href="{{ item.url }}">
                {% if design_img != blank %}
                  <img class="dwg-rd-cart__img" src="{{ design_img | asset_url }}" alt="{{ item.product.title }}" width="600" height="600" loading="lazy">
                {% elsif item.image %}
                  {{ item.image | image_url: width: 600 | image_tag: class: 'dwg-rd-cart__img', widths: '250, 400, 600', loading: 'lazy', alt: item.title }}
                {% endif %}
              </a>
              <div class="dwg-rd-cart__info">
                <p class="dwg-rd-cart__count">{{ item.quantity }} {{ item.quantity | pluralize: 'Product', 'Products' }}</p>
                <h2 class="dwg-rd-cart__name"><a href="{{ item.url }}">{{ item.product.title }}</a></h2>
                {% unless item.variant.title contains 'Default' %}
                  <p class="dwg-rd-cart__variant">{{ item.variant.title }}</p>
                {% endunless %}
                <p class="dwg-rd-cart__price-label">Price Tag</p>
                <p class="dwg-rd-cart__price">{{ item.final_line_price | money }}</p>

                <div class="dwg-rd-cart__actions">
                  <button type="submit" name="checkout" class="dwg-rd-cart__checkout">Move to Payment</button>
                  <a class="dwg-rd-cart__remove" href="{{ routes.cart_change_url }}?line={{ item.index | plus: 1 }}&quantity=0">Remove</a>
                </div>
              </div>
            </li>
          {% endfor %}
        </ul>
      </form>
    {% else %}
      <div class="dwg-rd-cart__empty">
        <h1>Your cart is empty</h1>
        <a class="dwg-rd-cart__shop" href="{{ routes.all_products_collection_url }}">Shop From Us</a>
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .dwg-rd-cart {
    background: var(--rd-ct-bg);
    padding-block: clamp(40px, 6vw, 88px);
    min-height: 50vh;
  }

  .dwg-rd-cart__count {
    font-family: 'Inter', sans-serif;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-size: clamp(0.9rem, 1.3vw, 1.05rem);
    color: var(--rd-ct-eyebrow);
    margin: 0 0 16px;
  }

  .dwg-rd-cart__list { list-style: none; margin: 0; padding: 0; }

  .dwg-rd-cart__item {
    display: flex;
    gap: clamp(24px, 6vw, 96px);
    align-items: center;
    padding-block: clamp(24px, 3vw, 40px);
  }

  .dwg-rd-cart__media {
    flex: 0 0 clamp(160px, 26vw, 320px);
    height: clamp(280px, 32vw, 440px);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .dwg-rd-cart__img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
  }

  .dwg-rd-cart__info { flex: 1 1 auto; min-width: 0; }

  .dwg-rd-cart__name {
    font-family: 'Outfit', sans-serif;
    font-weight: 400;
    text-transform: uppercase;
    font-size: clamp(1.75rem, 4vw, 3rem);
    line-height: 1.05;
    margin: 0 0 20px;
  }

  .dwg-rd-cart__name a { color: var(--rd-ct-text); text-decoration: none; }

  .dwg-rd-cart__variant {
    font-family: 'Manjari', sans-serif;
    color: rgba(28, 28, 28, 0.65);
    margin: 0 0 8px;
  }

  .dwg-rd-cart__price-label {
    font-family: 'Manjari', sans-serif;
    font-size: 0.95rem;
    color: rgba(28, 28, 28, 0.5);
    margin: 0 0 6px;
  }

  .dwg-rd-cart__price {
    font-family: 'Outfit', sans-serif;
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    margin: 0 0 28px;
  }

  .dwg-rd-cart__actions {
    display: flex;
    align-items: center;
    gap: clamp(20px, 3vw, 40px);
    flex-wrap: wrap;
  }

  .dwg-rd-cart__checkout {
    border: 0;
    cursor: pointer;
    font-family: 'Manjari', sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 1.05rem;
    padding: 17px 40px;
    background: var(--rd-ct-btn-bg);
    color: var(--rd-ct-btn-text);
    transition: filter 0.2s ease;
  }

  .dwg-rd-cart__checkout:hover { filter: brightness(1.08); }

  .dwg-rd-cart__remove {
    font-family: 'Outfit', sans-serif;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 1.05rem;
    color: var(--rd-ct-text);
    text-decoration: none;
  }

  .dwg-rd-cart__remove:hover { color: var(--rd-ct-eyebrow); }

  .dwg-rd-cart__empty { text-align: center; padding-block: 40px; }

  .dwg-rd-cart__empty h1 {
    font-family: 'Outfit', sans-serif;
    font-weight: 400;
    text-transform: uppercase;
    margin: 0 0 24px;
  }

  .dwg-rd-cart__shop {
    display: inline-block;
    font-family: 'Manjari', sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 15px 34px;
    background: var(--rd-ct-btn-bg);
    color: var(--rd-ct-btn-text);
    text-decoration: none;
  }

  .visually-hidden {
    position: absolute !important;
    width: 1px; height: 1px;
    overflow: hidden; clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  @media screen and (max-width: 600px) {
    .dwg-rd-cart__item { flex-direction: column; align-items: flex-start; }
    .dwg-rd-cart__actions { justify-content: stretch; }
    .dwg-rd-cart__checkout { flex: 1 1 auto; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "DWG RD: Cart",
  "settings": [
    { "type": "checkbox", "id": "use_design_images", "label": "Use design product images", "info": "Show the Figma product photos mapped by product title instead of each product's own image.", "default": true },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "eyebrow_color", "label": "Eyebrow", "default": "#B28100" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1C1C1C" },
    { "type": "color", "id": "button_background", "label": "Checkout button", "default": "#A97E0C" },
    { "type": "color", "id": "button_text_color", "label": "Checkout text", "default": "#FFFFFF" }
  ]
}
{% endschema %}
