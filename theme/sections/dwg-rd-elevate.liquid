{% comment %}
  DWG redesign — "Made to Elevate / Every Drop Matters" (v2).
  Left: eyebrow, split-color heading, body, CTA.
  Centre: three bottles + chilli bowl that DROP in from above on scroll
          (scroll-scrubbed, reverses on scroll up; disabled for reduced-motion).
  Right: feature rows. Remove this section to revert.
{% endcomment %}

{% liquid
  assign bg = section.settings.background | default: '#FBF7EF'
  assign eyebrow_color = section.settings.eyebrow_color | default: '#B28100'
  assign accent = section.settings.accent_color | default: '#B28100'
  assign text_color = section.settings.text_color | default: '#1C1C1C'
  assign btn_bg = section.settings.button_background | default: '#A97E0C'
  assign btn_text = section.settings.button_text_color | default: '#FFFFFF'
%}

<section
  class="dwg-rd-elevate"
  style="
    --rd-el-bg: {{ bg }};
    --rd-el-eyebrow: {{ eyebrow_color }};
    --rd-el-accent: {{ accent }};
    --rd-el-text: {{ text_color }};
    --rd-el-btn-bg: {{ btn_bg }};
    --rd-el-btn-text: {{ btn_text }};
  "
  data-dwg-elevate
>
  <div class="dwg-rd-elevate__wrap page-width">
    <div class="dwg-rd-elevate__content">
      {% if section.settings.eyebrow != blank %}
        <p class="dwg-rd-elevate__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="dwg-rd-elevate__heading">
          <span class="dwg-rd-elevate__heading-accent">{{ section.settings.heading_accent }}</span>
          {{ section.settings.heading }}
        </h2>
      {% endif %}
      {% if section.settings.body != blank %}
        <div class="dwg-rd-elevate__body">{{ section.settings.body }}</div>
      {% endif %}
    </div>

    <div class="dwg-rd-elevate__media">
      <div class="dwg-rd-elevate__media-bottle">
        {% if section.settings.product_image != blank %}
          {{ section.settings.product_image | image_url: width: 1300 | image_tag: class: 'dwg-rd-elevate__bottle-img', widths: '600, 900, 1300', loading: 'lazy', alt: 'DWG chilli oil' }}
        {% else %}
          <img class="dwg-rd-elevate__bottle-img" src="{{ 'dwg-rd-elevate-trio-bowl.png' | asset_url }}" alt="DWG chilli oil — three bottles and chilli bowl" width="942" height="951" loading="lazy">
        {% endif %}
        {%- comment -%} Landing target for the bottle flying in from the hero (over the centre bottle). {%- endcomment -%}
        <span class="dwg-rd-elevate__land" data-land aria-hidden="true"></span>
      </div>
    </div>

    {% if section.blocks.size > 0 %}
      <div class="dwg-rd-elevate__features">
        {% for block in section.blocks %}
          <div class="dwg-rd-elevate__feature" {{ block.shopify_attributes }}>
            <div class="dwg-rd-elevate__feature-icon">
              {% if block.settings.icon != blank %}
                {{ block.settings.icon | image_url: width: 120 | image_tag: widths: '60, 120', loading: 'lazy', alt: block.settings.title }}
              {% else %}
                {% if forloop.index == 1 %}
                  <img src="{{ 'dwg-rd-feature-1.png' | asset_url }}" alt="{{ block.settings.title }}" width="120" height="120" loading="lazy">
                {% elsif forloop.index == 2 %}
                  <img src="{{ 'dwg-rd-feature-2.png' | asset_url }}" alt="{{ block.settings.title }}" width="120" height="120" loading="lazy">
                {% endif %}
              {% endif %}
            </div>
            <div class="dwg-rd-elevate__feature-text">
              {% if block.settings.title != blank %}
                <h3 class="dwg-rd-elevate__feature-title">{{ block.settings.title }}</h3>
              {% endif %}
              {% if block.settings.description != blank %}
                <p class="dwg-rd-elevate__feature-desc">{{ block.settings.description }}</p>
              {% endif %}
            </div>
          </div>
        {% endfor %}
        {% if section.settings.button_label != blank %}
          <a class="dwg-rd-elevate__btn" href="{{ section.settings.button_link | default: '#' }}">
            {{ section.settings.button_label }}
          </a>
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .dwg-rd-elevate {
    background-color: var(--rd-el-bg);
    padding-block: clamp(28px, 5vw, 64px) clamp(32px, 5vw, 64px);
    margin-top: clamp(8px, 1vw, 16px);
    margin-bottom: clamp(8px, 1vw, 16px);
    position: relative;
    z-index: 2;
    overflow: hidden;
  }

  .dwg-rd-elevate__wrap {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(24px, 4vw, 48px);
    align-items: center;
  }

  @media screen and (min-width: 900px) {
    .dwg-rd-elevate__wrap {
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.5fr) minmax(0, 0.85fr);
    }
  }

  .dwg-rd-elevate__eyebrow {
    font-family: 'Inter', sans-serif;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-size: clamp(0.85rem, 1.4vw, 1rem);
    color: var(--rd-el-eyebrow);
    margin: 0 0 14px;
  }

  .dwg-rd-elevate__heading {
    font-family: 'Outfit', sans-serif;
    font-weight: 400;
    line-height: 1.05;
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    color: var(--rd-el-text);
    margin: 0 0 20px;
  }

  .dwg-rd-elevate__heading-accent { color: var(--rd-el-accent); }

  .dwg-rd-elevate__body {
    font-family: 'Manjari', sans-serif;
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    line-height: 1.55;
    color: var(--rd-el-text);
    max-width: 42ch;
    margin: 0 0 28px;
  }

  .dwg-rd-elevate__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: 'Manjari', sans-serif;
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 15px 34px;
    background: var(--rd-el-btn-bg);
    color: var(--rd-el-btn-text);
    border-radius: 4px;
    justify-self: stretch;
    text-align: center;
    margin-top: 20px;
    transition: filter 0.2s ease, transform 0.2s ease;
  }
  .dwg-rd-elevate__btn:hover { filter: brightness(1.08); }

  /* Centre cluster */
  .dwg-rd-elevate__media {
    position: relative;
    width: 100%;
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }
  .dwg-rd-elevate__media-bottle {
    position: relative;
    z-index: 2;
    display: block;
    width: 100%;
    max-width: 640px;
    margin-inline: auto;
  }
  .dwg-rd-elevate__bottle-img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
  }
  /* Landing box over the CENTRE bottle of the cluster image (matches bottle aspect) */
  .dwg-rd-elevate__land {
    position: absolute;
    left: 28.03%;
    top: -9.99%;
    width: 77.18%;
    height: 126.18%;
    pointer-events: none;
  }

  /* Features */
  .dwg-rd-elevate__features {
    display: grid;
    gap: 20px;
    align-self: center;
    max-width: 340px;
  }
  .dwg-rd-elevate__feature {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding-block-start: 20px;
    border-top: 1px solid rgba(28, 28, 28, 0.15);
  }
  .dwg-rd-elevate__feature:first-child { border-top: none; padding-block-start: 0; }
  .dwg-rd-elevate__feature-icon {
    flex: 0 0 auto;
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .dwg-rd-elevate__feature-icon img { width: 100%; height: 100%; object-fit: contain; }
  .dwg-rd-elevate__feature-title {
    font-family: 'Manjari', sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    font-size: 1.05rem;
    margin: 0 0 4px;
    color: var(--rd-el-text);
  }
  .dwg-rd-elevate__feature-desc {
    font-family: 'Manjari', sans-serif;
    font-size: 0.95rem;
    line-height: 1.45;
    color: rgba(28, 28, 28, 0.72);
    margin: 0;
  }

  @media screen and (max-width: 899px) {
    .dwg-rd-elevate { margin-top: 0; padding-top: clamp(24px, 6vw, 40px); }
    .dwg-rd-elevate__content { text-align: center; }
    .dwg-rd-elevate__body { margin-inline: auto; }
    .dwg-rd-elevate__media { margin-block: 4px 8px; }
    .dwg-rd-elevate__media-bottle { max-width: min(370px, 72vw); margin-inline: auto; }
    .dwg-rd-elevate__features { max-width: none; align-items: center; }
    .dwg-rd-elevate__btn { justify-self: stretch; }
  }

  /* ── Drop-in motion (scroll-scrubbed; JS sets --drop 1→0 as it settles) ── */
  .dwg-rd-elevate__media-bottle[data-drop] {
    transform: translateY(calc(var(--drop, 1) * -22%));
    opacity: calc(1 - var(--drop, 1) * 0.9);
  }
  @media (prefers-reduced-motion: reduce) {
    .dwg-rd-elevate__media-bottle[data-drop] { transform: none !important; opacity: 1 !important; }
  }
{% endstylesheet %}

<script>
  (function () {
    var root = document.currentScript.previousElementSibling;
    while (root && !(root.hasAttribute && root.hasAttribute('data-dwg-elevate'))) {
      root = root.previousElementSibling;
    }
    if (!root) return;
    var drop = root.querySelector('[data-drop]');
    if (!drop) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) { drop.style.setProperty('--drop', '0'); return; }

    var ticking = false;
    function frame() {
      ticking = false;
      var vh = window.innerHeight || document.documentElement.clientHeight;
      var r = drop.getBoundingClientRect();
      // p = 0 when the cluster first appears at the bottom of the viewport,
      // p = 1 once it has risen to ~35% from the top (settled).
      var start = vh;            // element top at viewport bottom
      var end = vh * 0.32;       // element top settled near upper third
      var p = (start - r.top) / (start - end);
      p = Math.max(0, Math.min(1, p));
      // --drop goes 1 (up & faded) -> 0 (settled) as p 0 -> 1
      drop.style.setProperty('--drop', String(1 - p));
    }
    function onScroll() { if (!ticking) { ticking = true; requestAnimationFrame(frame); } }
    frame();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    window.addEventListener('load', frame);
  })();
</script>

{% schema %}
{
  "name": "DWG RD: Elevate",
  "tag": "section",
  "class": "section--dwg-rd-elevate",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Made to Elevate" },
    { "type": "text", "id": "heading_accent", "label": "Heading (accent word)", "default": "Every" },
    { "type": "text", "id": "heading", "label": "Heading (rest)", "default": "Drop Matters" },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Our chilli oil is a perfect balance of heat, crunch and aroma. Made with premium chilli flakes & spices infused in quality ingredients.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop From Us" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "image_picker", "id": "product_image", "label": "Product image (bottles + bowl)", "info": "Defaults to dwg-rd-elevate-trio-bowl.png theme asset." },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background", "label": "Background", "default": "#FBF7EF" },
    { "type": "color", "id": "eyebrow_color", "label": "Eyebrow", "default": "#B28100" },
    { "type": "color", "id": "accent_color", "label": "Heading accent", "default": "#B28100" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1C1C1C" },
    { "type": "color", "id": "button_background", "label": "Button background", "default": "#A97E0C" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#FFFFFF" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Icon" },
        { "type": "text", "id": "title", "label": "Title", "default": "Tasty Oil" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Infused in high quality oils for a rich, smooth finish." }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "DWG RD: Elevate",
      "blocks": [
        { "type": "feature", "settings": { "title": "Tasty Oil", "description": "Infused in high quality oils for a rich, smooth finish." } },
        { "type": "feature", "settings": { "title": "African Seasoning", "description": "Bold, authentic spice blends rooted in tradition." } }
      ]
    }
  ]
}
{% endschema %}
