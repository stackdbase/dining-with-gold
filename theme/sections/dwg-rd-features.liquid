{% comment %}
  DWG redesign — 4-up icon feature strip (Quality Ingredients / Crispy
  Garlic / Premium Oil / Bold & Versatile). Remove from template to revert.
{% endcomment %}

{% liquid
  assign bg = section.settings.background | default: '#FFFFFF'
  assign card_bg = section.settings.card_background | default: '#FBF6EC'
  assign accent = section.settings.accent_color | default: '#BD8C1E'
  assign text_color = section.settings.text_color | default: '#1C1C1C'
%}

<section class="dwg-rd-feat" style="--rd-ft-bg: {{ bg }}; --rd-ft-card: {{ card_bg }}; --rd-ft-accent: {{ accent }}; --rd-ft-text: {{ text_color }};">
  <div class="dwg-rd-feat__wrap page-width">
    <div class="dwg-rd-feat__grid">
      {% for block in section.blocks %}
        <div class="dwg-rd-feat__item" {{ block.shopify_attributes }}>
          <span class="dwg-rd-feat__icon" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'leaf' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20c0-9 7-16 16-16 0 9-7 16-16 16z"/><path d="M4 20c4-4 8-8 12-12"/></svg>
              {%- when 'garlic' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2c1.5 2 1.5 3.5 0 5"/><path d="M12 7c4 0 6 3.5 6 8a6 6 0 0 1-12 0c0-4.5 2-8 6-8z"/><path d="M12 7v13M9 9c-1 3-1 6 0 10M15 9c1 3 1 6 0 10"/></svg>
              {%- when 'drop' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2s6 7 6 12a6 6 0 0 1-12 0c0-5 6-12 6-12z"/></svg>
              {%- when 'chilli' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 18c7 2 13-3 15-11"/><path d="M19 7c0-2 1-3 2-3M15 8c1.5 0 3-1 4-3"/></svg>
              {%- else -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l2.4 1.5 2.8-.4 1.5 2.4 2.4 1.5-.4 2.8L22 12l-1.3 2.2.4 2.8-2.4 1.5-1.5 2.4-2.8-.4L12 22l-2.4-1.5-2.8.4-1.5-2.4L2.9 17l.4-2.8L2 12l1.3-2.2-.4-2.8 2.4-1.5L6.8 3.1l2.8.4L12 2z"/></svg>
            {%- endcase -%}
          </span>
          {% if block.settings.title != blank %}<h3 class="dwg-rd-feat__title">{{ block.settings.title }}</h3>{% endif %}
          {% if block.settings.description != blank %}<p class="dwg-rd-feat__desc">{{ block.settings.description }}</p>{% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .dwg-rd-feat { background: var(--rd-ft-bg); padding-block: clamp(24px, 4vw, 48px); }

  .dwg-rd-feat__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    background: var(--rd-ft-card);
    border-radius: 16px;
    overflow: hidden;
  }

  @media screen and (min-width: 850px) {
    .dwg-rd-feat__grid { grid-template-columns: repeat(4, 1fr); }
  }

  .dwg-rd-feat__item {
    text-align: center;
    padding: clamp(24px, 3vw, 40px) clamp(16px, 2vw, 28px);
    border-right: 1px solid rgba(28, 28, 28, 0.08);
    border-bottom: 1px solid rgba(28, 28, 28, 0.08);
  }

  .dwg-rd-feat__icon {
    display: inline-flex;
    width: 40px;
    height: 40px;
    color: var(--rd-ft-accent);
    margin-bottom: 16px;
  }
  .dwg-rd-feat__icon svg { width: 100%; height: 100%; }

  .dwg-rd-feat__title {
    font-family: 'Outfit', sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    font-size: 0.95rem;
    color: var(--rd-ft-text);
    margin: 0 0 8px;
  }

  .dwg-rd-feat__desc {
    font-family: 'Manjari', sans-serif;
    font-size: 0.9rem;
    line-height: 1.45;
    color: rgba(28, 28, 28, 0.7);
    margin: 0;
    max-width: 24ch;
    margin-inline: auto;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "DWG RD: Feature strip",
  "settings": [
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "card_background", "label": "Strip background", "default": "#FBF6EC" },
    { "type": "color", "id": "accent_color", "label": "Icon", "default": "#BD8C1E" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1C1C1C" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [ { "value": "leaf", "label": "Leaf" }, { "value": "garlic", "label": "Garlic" }, { "value": "drop", "label": "Oil drop" }, { "value": "chilli", "label": "Chilli" }, { "value": "seal", "label": "Seal" } ], "default": "leaf" },
        { "type": "text", "id": "title", "label": "Title", "default": "Quality Ingredients" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Carefully selected chillies and spices for bold flavor." }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "DWG RD: Feature strip",
      "blocks": [
        { "type": "feature", "settings": { "icon": "leaf", "title": "Quality Ingredients", "description": "Carefully selected chillies and spices for bold flavor." } },
        { "type": "feature", "settings": { "icon": "garlic", "title": "Crispy Garlic", "description": "Golden, flavorful garlic for that irresistible crunch." } },
        { "type": "feature", "settings": { "icon": "drop", "title": "Premium Oil", "description": "Infused in high-quality oil for a rich, smooth finish." } },
        { "type": "feature", "settings": { "icon": "chilli", "title": "Bold & Versatile", "description": "Perfect for any dish that deserves more flavor." } }
      ]
    }
  ]
}
{% endschema %}
