{% comment %}
  DWG redesign — site-wide footer. Cream band: logo + brand (left),
  newsletter (right), slim legal/social row beneath. Remove from
  footer-group.json to revert.
{% endcomment %}

{% liquid
  assign bg = section.settings.background | default: '#FBEABC'
  assign text_color = section.settings.text_color | default: '#1C1C1C'
  assign btn_bg = section.settings.button_background | default: '#BD8C1E'
  assign btn_text = section.settings.button_text_color | default: '#FFFFFF'
%}

<footer
  class="dwg-rd-footer"
  style="--rd-ft-bg: {{ bg }}; --rd-ft-text: {{ text_color }}; --rd-ft-btn-bg: {{ btn_bg }}; --rd-ft-btn-text: {{ btn_text }};"
>
  <div class="dwg-rd-footer__wrap page-width">
    <div class="dwg-rd-footer__brand">
      {% if section.settings.logo != blank %}
        {{ section.settings.logo | image_url: width: 400 | image_tag: class: 'dwg-rd-footer__logo', widths: '200, 400', loading: 'lazy', alt: shop.name }}
      {% else %}
        <img class="dwg-rd-footer__logo" src="{{ 'dwg-rd-logo.png' | asset_url }}" alt="{{ shop.name }}" width="200" height="158" loading="lazy">
      {% endif %}
      {% if section.settings.brand_text != blank %}
        <p class="dwg-rd-footer__brand-text">{{ section.settings.brand_text }}</p>
      {% endif %}
    </div>

    <div class="dwg-rd-footer__news">
      {% if section.settings.heading != blank %}
        <h2 class="dwg-rd-footer__heading">{{ section.settings.heading }}</h2>
      {% endif %}
      {% form 'customer', class: 'dwg-rd-footer__form' %}
        {% if form.posted_successfully? %}
          <p class="dwg-rd-footer__success">Thanks for subscribing! Watch your inbox for gold.</p>
        {% else %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="dwg-rd-footer__field">
            <input type="email" name="contact[email]" class="dwg-rd-footer__input" placeholder="{{ section.settings.placeholder | default: 'Your email address' }}" aria-label="Email" required>
            <button type="submit" class="dwg-rd-footer__btn">{{ section.settings.button_label | default: 'Send' }}</button>
          </div>
        {% endif %}
      {% endform %}
    </div>
  </div>

  <div class="dwg-rd-footer__bottom page-width">
    <p class="dwg-rd-footer__copy">© {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</p>
    {% if section.settings.legal_menu != blank and linklists[section.settings.legal_menu].links.size > 0 %}
      <nav class="dwg-rd-footer__legal">
        {% for link in linklists[section.settings.legal_menu].links %}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {% endfor %}
      </nav>
    {% endif %}
  </div>
</footer>

{% stylesheet %}
  .dwg-rd-footer {
    background: var(--rd-ft-bg);
    color: var(--rd-ft-text);
    padding-block: clamp(32px, 5vw, 56px);
  }

  .dwg-rd-footer__wrap {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(24px, 4vw, 48px);
    align-items: center;
  }

  @media screen and (min-width: 750px) {
    .dwg-rd-footer__wrap {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    }
  }

  .dwg-rd-footer__logo {
    height: 96px;
    width: auto;
    object-fit: contain;
    display: block;
  }

  .dwg-rd-footer__brand-text {
    font-family: 'Outfit', sans-serif;
    font-size: 1.5rem;
    margin: 12px 0 0;
  }

  .dwg-rd-footer__heading {
    font-family: 'Outfit', sans-serif;
    font-weight: 400;
    font-size: clamp(1.35rem, 2.5vw, 1.9rem);
    margin: 0 0 18px;
  }

  .dwg-rd-footer__field {
    display: flex;
    background: #fff;
    max-width: 520px;
    overflow: hidden;
    border-radius: 2px;
  }

  .dwg-rd-footer__input {
    flex: 1 1 auto;
    border: 0;
    padding: 18px 20px;
    font-family: 'Outfit', sans-serif;
    font-size: 1rem;
    background: transparent;
    color: #1c1c1c;
  }

  .dwg-rd-footer__input:focus {
    outline: 2px solid var(--rd-ft-btn-bg);
    outline-offset: -2px;
  }

  .dwg-rd-footer__btn {
    flex: 0 0 auto;
    border: 0;
    cursor: pointer;
    padding: 0 30px;
    font-family: 'Outfit', sans-serif;
    font-weight: 600;
    font-size: 1.05rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    background: var(--rd-ft-btn-bg);
    color: var(--rd-ft-btn-text);
    transition: filter 0.2s ease;
  }

  .dwg-rd-footer__btn:hover { filter: brightness(1.08); }

  .dwg-rd-footer__success {
    font-family: 'Outfit', sans-serif;
    font-size: 1.1rem;
    margin: 0;
  }

  .dwg-rd-footer__bottom {
    margin-top: clamp(24px, 4vw, 40px);
    padding-top: 20px;
    border-top: 1px solid rgba(28, 28, 28, 0.14);
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    align-items: center;
    justify-content: space-between;
  }

  .dwg-rd-footer__copy {
    font-family: 'Outfit', sans-serif;
    font-size: 0.85rem;
    margin: 0;
    opacity: 0.8;
  }

  .dwg-rd-footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
  }

  .dwg-rd-footer__legal a {
    font-family: 'Outfit', sans-serif;
    font-size: 0.85rem;
    color: var(--rd-ft-text);
    text-decoration: none;
    opacity: 0.8;
  }

  .dwg-rd-footer__legal a:hover { opacity: 1; }
{% endstylesheet %}

{% schema %}
{
  "name": "DWG RD: Footer",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "text", "id": "brand_text", "label": "Brand text", "default": "Dining with Gold" },
    { "type": "text", "id": "heading", "label": "Newsletter heading", "default": "Subscribe to Our Newsletter" },
    { "type": "text", "id": "placeholder", "label": "Input placeholder", "default": "Your email address" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Send" },
    { "type": "link_list", "id": "legal_menu", "label": "Legal menu", "info": "Optional links row (e.g. the 'legal' menu)." },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background", "label": "Background", "default": "#FBEABC" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1C1C1C" },
    { "type": "color", "id": "button_background", "label": "Button background", "default": "#BD8C1E" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#FFFFFF" }
  ]
}
{% endschema %}
