{% comment %}
  DWG redesign — Hero (v3). Left: orange/chilli lifestyle background (bottle
  removed) with a CRISP bottle laid on top; on scroll the bottle lifts off,
  rotates upright and flies down to land by the bowl in the Elevate section
  (scroll-scrubbed, reverses on scroll up, reduced-motion safe).
  Right: heading, gold sub-heading, body, CTA.
  (Earlier carousel/scroll-fall lives on branch redesign-v1-carousel-scrollfall.)
{% endcomment %}

{% liquid
  assign bg = section.settings.background | default: '#FBF7EF'
  assign heading_color = section.settings.heading_color | default: '#BD8C1E'
  assign sub_color = section.settings.subheading_color | default: '#BD8C1E'
  assign text_color = section.settings.text_color | default: '#1C1C1C'
  assign btn_bg = section.settings.button_background | default: '#A97E0C'
  assign btn_text = section.settings.button_text_color | default: '#FFFFFF'
%}

<section
  class="dwg-rd-hero"
  style="
    --rd-hero-bg: {{ bg }};
    --rd-hero-heading: {{ heading_color }};
    --rd-hero-sub: {{ sub_color }};
    --rd-hero-text: {{ text_color }};
    --rd-hero-btn-bg: {{ btn_bg }};
    --rd-hero-btn-text: {{ btn_text }};
  "
  data-dwg-hero
>
  <div class="dwg-rd-hero__inner">
    <div class="dwg-rd-hero__panel">
      {% if section.settings.panel_image != blank %}
        {{ section.settings.panel_image | image_url: width: 1540 | image_tag: class: 'dwg-rd-hero__panel-img', widths: '700, 1100, 1540', loading: 'eager', alt: section.settings.heading | default: 'DWG African Chilli Oil' }}
      {% else %}
        <img class="dwg-rd-hero__panel-img" src="{{ 'dwg-rd-hero-bg.png' | asset_url }}" alt="{{ section.settings.heading | default: 'DWG African Chilli Oil' }}" width="1540" height="1024" loading="eager">
      {% endif %}
      <span class="dwg-rd-hero__bottle" data-fly-origin aria-hidden="true">
        <img src="{{ 'dwg-rd-shop-bottle.png' | asset_url }}" alt="" width="849" height="1400" loading="eager">
      </span>
    </div>

    <div class="dwg-rd-hero__content">
      {% if section.settings.heading != blank %}
        <h1 class="dwg-rd-hero__heading">{{ section.settings.heading }}</h1>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <p class="dwg-rd-hero__subhead">{{ section.settings.subheading }}</p>
      {% endif %}
      {% if section.settings.body != blank %}
        <div class="dwg-rd-hero__body">{{ section.settings.body }}</div>
      {% endif %}
      {% if section.settings.button_label != blank %}
        <a class="dwg-rd-hero__btn" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label }}</a>
      {% endif %}
    </div>
  </div>

  {%- comment -%} Scroll-scrubbed flyer: lifts the bottle from the hero into the Elevate section. {%- endcomment -%}
  <div class="dwg-hero-fly" data-fly aria-hidden="true">
    <img src="{{ 'dwg-rd-shop-bottle.png' | asset_url }}" alt="" width="849" height="1400" loading="eager">
  </div>
</section>

{% stylesheet %}
  /* Homepage sits on white — no cream page background peeking between sections */
  body:has(.dwg-rd-hero) { background-color: #FFFFFF !important; }

  .dwg-rd-hero {
    position: relative;
    background-color: var(--rd-hero-bg);
    padding-block: clamp(10px, 1.6vw, 20px);
    overflow-x: clip;
  }

  .dwg-rd-hero__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(20px, 4vw, 40px);
    align-items: center;
  }

  .dwg-rd-hero__panel {
    position: relative;
    overflow: hidden;
    line-height: 0;
    border-radius: clamp(18px, 4vw, 28px);
    height: 48svh;
    max-height: 440px;
  }

  .dwg-rd-hero__panel-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* Bottle laid on the background (its own layer so it can lift off) */
  .dwg-rd-hero__bottle {
    position: absolute;
    left: 46%;
    top: 50%;
    width: 54%;
    transform: translate(-50%, -50%);
    z-index: 2;
    line-height: 0;
  }
  .dwg-rd-hero__bottle img {
    width: 100%;
    height: auto;
    display: block;
    transform: rotate(16deg);
    transform-origin: center center;
  }

  .dwg-rd-hero__content {
    padding-inline: clamp(20px, 5vw, 48px);
  }

  .dwg-rd-hero__heading {
    font-family: 'Outfit', sans-serif;
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 0.95;
    margin: 0 0 18px;
    font-size: clamp(2.4rem, 6.4vw, 5.6rem);
    color: var(--rd-hero-heading);
    text-transform: uppercase;
    overflow-wrap: break-word;
  }

  .dwg-rd-hero__subhead {
    font-family: 'Inter', sans-serif;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-size: clamp(0.95rem, 1.5vw, 1.2rem);
    color: var(--rd-hero-sub);
    margin: 0 0 18px;
  }

  .dwg-rd-hero__body {
    font-family: 'Manjari', sans-serif;
    font-size: clamp(1.1rem, 1.8vw, 1.4rem);
    line-height: 1.5;
    color: var(--rd-hero-text);
    max-width: 40ch;
    margin: 0 0 30px;
  }

  .dwg-rd-hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: 'Manjari', sans-serif;
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 16px 40px;
    min-width: min(300px, 100%);
    background: var(--rd-hero-btn-bg);
    color: var(--rd-hero-btn-text);
    border-radius: 4px;
    transition: filter 0.2s ease, transform 0.2s ease;
  }
  .dwg-rd-hero__btn:hover { filter: brightness(1.08); }

  /* Flyer (fixed, scroll-scrubbed) */
  .dwg-hero-fly {
    position: fixed;
    z-index: 6;
    pointer-events: none;
    opacity: 0;
    will-change: transform, top, left, width;
    line-height: 0;
  }
  .dwg-hero-fly img {
    width: 100%;
    height: auto;
    display: block;
    transform-origin: center center;
  }

  @media screen and (min-width: 900px) {
    .dwg-rd-hero { padding-block: 0; }
    /* Full-bleed: panel FILLS the left column; content capped + centred. */
    .dwg-rd-hero__inner {
      grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr);
      gap: 0;
      align-items: stretch;
    }
    .dwg-rd-hero__panel {
      order: 1;
      height: min(64svh, 600px);
      max-height: none;
      border-radius: 0 clamp(24px, 3vw, 40px) clamp(24px, 3vw, 40px) 0;
    }
    .dwg-rd-hero__panel-img { object-position: center 46%; }
    .dwg-rd-hero__bottle { width: 48%; }
    .dwg-rd-hero__content {
      order: 2;
      align-self: center;
      justify-self: center;
      max-width: 760px;
      padding-inline: clamp(24px, 4vw, 72px);
    }
  }

  @media screen and (max-width: 899px) {
    .dwg-rd-hero__inner { gap: clamp(18px, 5vw, 28px); padding-inline: clamp(14px, 4vw, 24px); }
    .dwg-rd-hero__panel { order: 1; }
    .dwg-rd-hero__bottle { width: 52%; }
    .dwg-rd-hero__content { order: 2; text-align: center; padding-inline: clamp(16px, 5vw, 28px); }
    .dwg-rd-hero__subhead,
    .dwg-rd-hero__body { margin-inline: auto; }
  }

  /* ── Entrance motion ── */
  .dwg-rd-hero__panel { opacity: 0; transform: scale(0.97); transition: opacity 0.7s ease, transform 0.7s ease; }
  .dwg-rd-hero__heading,
  .dwg-rd-hero__subhead,
  .dwg-rd-hero__body,
  .dwg-rd-hero__btn { opacity: 0; transform: translateY(18px); transition: opacity 0.6s ease, transform 0.6s ease; }
  .dwg-rd-hero.is-in .dwg-rd-hero__panel   { opacity: 1; transform: none; }
  .dwg-rd-hero.is-in .dwg-rd-hero__heading { opacity: 1; transform: none; transition-delay: 0.12s; }
  .dwg-rd-hero.is-in .dwg-rd-hero__subhead { opacity: 1; transform: none; transition-delay: 0.22s; }
  .dwg-rd-hero.is-in .dwg-rd-hero__body    { opacity: 1; transform: none; transition-delay: 0.32s; }
  .dwg-rd-hero.is-in .dwg-rd-hero__btn     { opacity: 1; transform: none; transition-delay: 0.42s; }

  @media (prefers-reduced-motion: reduce) {
    .dwg-rd-hero__panel,
    .dwg-rd-hero__heading,
    .dwg-rd-hero__subhead,
    .dwg-rd-hero__body,
    .dwg-rd-hero__btn { opacity: 1 !important; transform: none !important; transition: none !important; }
    .dwg-hero-fly { display: none !important; }
  }
{% endstylesheet %}

<script>
  (function () {
    var root = document.currentScript.previousElementSibling;
    while (root && !(root.hasAttribute && root.hasAttribute('data-dwg-hero'))) {
      root = root.previousElementSibling;
    }
    if (!root) return;
    requestAnimationFrame(function () { root.classList.add('is-in'); });

    // ── Scroll-scrubbed bottle lift: hero bottle -> Elevate landing spot ──
    (function () {
      var origin = root.querySelector('[data-fly-origin]');
      var fly = root.querySelector('[data-fly]');
      var flyImg = fly && fly.querySelector('img');
      if (!origin || !fly || !flyImg) return;

      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
      var dest = null, active = false, range = 1, ticking = false;
      var ANGLE = 16;   // hero tilt (deg) -> 0 upright at landing
      var SPEED = 1.3;  // >1 = slower fall (bottle travels over more scroll)

      function enable() { if (active) return; active = true; origin.style.visibility = 'hidden'; }
      function disable() {
        if (!active) return;
        active = false;
        origin.style.visibility = '';
        fly.style.opacity = '0';
        fly.style.left = fly.style.top = fly.style.width = '';
      }
      function measure() {
        var y = window.pageYOffset || document.documentElement.scrollTop;
        var o = origin.getBoundingClientRect();
        var d = dest.getBoundingClientRect();
        range = Math.max(1, (d.top + y) - (o.top + y)) * SPEED;
      }
      function lerp(a, b, p) { return a + (b - a) * p; }
      function frame() {
        ticking = false;
        if (!active) return;
        var y = window.pageYOffset || document.documentElement.scrollTop;
        var p = Math.min(1, Math.max(0, y / range));
        var o = origin.getBoundingClientRect();
        var d = dest.getBoundingClientRect();
        fly.style.left = lerp(o.left, d.left, p) + 'px';
        fly.style.top = lerp(o.top, d.top, p) + 'px';
        fly.style.width = lerp(o.width, d.width, p) + 'px';
        flyImg.style.transform = 'rotate(' + lerp(ANGLE, 0, p) + 'deg)';
        fly.style.opacity = '1';
      }
      function onScroll() { if (!ticking) { ticking = true; requestAnimationFrame(frame); } }
      function setup() {
        dest = document.querySelector('[data-land]');
        var on = dest && !reduce.matches;
        if (on) { enable(); measure(); frame(); } else { disable(); }
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setup);
      } else { setup(); }
      window.addEventListener('load', function () { measure(); frame(); });
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', function () { setup(); });
    })();
  })();
</script>

{% schema %}
{
  "name": "DWG RD: Hero",
  "tag": "section",
  "class": "section--dwg-rd-hero",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "No 1 African Chilli Oil" },
    { "type": "text", "id": "subheading", "label": "Sub-heading", "default": "Heat Flavor, Gold Standard" },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Premium chilli oil crafted to elevate every meal with bold, unforgettable flavor.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop From Us" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "image_picker", "id": "panel_image", "label": "Panel background (bottle removed)", "info": "Defaults to dwg-rd-hero-bg.png theme asset." },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background", "label": "Background", "default": "#FBF7EF" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#BD8C1E" },
    { "type": "color", "id": "subheading_color", "label": "Sub-heading", "default": "#BD8C1E" },
    { "type": "color", "id": "text_color", "label": "Body text", "default": "#1C1C1C" },
    { "type": "color", "id": "button_background", "label": "Button background", "default": "#A97E0C" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#FFFFFF" }
  ],
  "presets": [ { "name": "DWG RD: Hero" } ]
}
{% endschema %}
