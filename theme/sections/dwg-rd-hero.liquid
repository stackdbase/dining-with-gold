{% comment %}
  DWG redesign — Hero. "No 1 African Chilli Oil".
  Live text rebuild of the Figma hero (node 449:354 top region), so the
  headline stays editable, responsive and SEO-friendly. Chef + product
  render as separate circular images. Remove this section to revert.
{% endcomment %}

{% liquid
  assign bg = section.settings.background | default: '#FFFFFF'
  assign heading_color = section.settings.heading_color | default: '#BD8C1E'
  assign eyebrow_color = section.settings.eyebrow_color | default: '#A0341E'
  assign text_color = section.settings.text_color | default: '#1C1C1C'
  assign btn_bg = section.settings.button_background | default: '#A97E0C'
  assign btn_text = section.settings.button_text_color | default: '#FFFFFF'
%}

<section
  class="dwg-rd-hero"
  style="
    --rd-hero-bg: {{ bg }};
    --rd-hero-heading: {{ heading_color }};
    --rd-hero-eyebrow: {{ eyebrow_color }};
    --rd-hero-text: {{ text_color }};
    --rd-hero-btn-bg: {{ btn_bg }};
    --rd-hero-btn-text: {{ btn_text }};
  "
>
  <div class="dwg-rd-hero__wrap page-width">
    <div class="dwg-rd-hero__content">
      {% if section.settings.heading != blank %}
        <h1 class="dwg-rd-hero__heading">{{ section.settings.heading }}</h1>
      {% endif %}
      {% if section.settings.eyebrow != blank %}
        <p class="dwg-rd-hero__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      {% if section.settings.body != blank %}
        <div class="dwg-rd-hero__body">{{ section.settings.body }}</div>
      {% endif %}
      {% if section.settings.button_label != blank %}
        <a class="dwg-rd-hero__btn" href="{{ section.settings.button_link | default: '#' }}">
          {{ section.settings.button_label }}
        </a>
      {% endif %}
    </div>

    <div class="dwg-rd-hero__media">
      <div class="dwg-rd-hero__chef">
        {% if section.settings.chef_image != blank %}
          {{
            section.settings.chef_image
            | image_url: width: 900
            | image_tag: class: 'dwg-rd-hero__chef-img', widths: '400, 600, 900', loading: 'eager', alt: section.settings.chef_image.alt | default: 'DWG founder'
          }}
        {% else %}
          <img
            class="dwg-rd-hero__chef-img"
            src="{{ 'dwg-rd-hero-chef.jpg' | asset_url }}"
            alt="DWG founder"
            width="800"
            height="800"
            loading="eager"
          >
        {% endif %}
      </div>
      <div class="dwg-rd-hero__product">
        {% if section.settings.product_image != blank %}
          {{
            section.settings.product_image
            | image_url: width: 600
            | image_tag: class: 'dwg-rd-hero__product-img', widths: '300, 450, 600', loading: 'eager', alt: section.settings.product_image.alt | default: 'DWG chilli oil'
          }}
        {% else %}
          <img
            class="dwg-rd-hero__product-img"
            src="{{ 'dwg-rd-more-bottle.png' | asset_url }}"
            alt="DWG chilli oil"
            width="600"
            height="600"
            loading="eager"
          >
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .dwg-rd-hero {
    background-color: var(--rd-hero-bg);
    padding-block: clamp(32px, 6vw, 72px);
    overflow: hidden;
  }

  .dwg-rd-hero__wrap {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(24px, 5vw, 48px);
    align-items: center;
  }

  @media screen and (min-width: 900px) {
    .dwg-rd-hero__wrap {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  .dwg-rd-hero__heading {
    font-family: 'Outfit', sans-serif;
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 0.98;
    margin: 0 0 20px;
    font-size: clamp(2.75rem, 7vw, 5.25rem);
    color: var(--rd-hero-heading);
    text-transform: uppercase;
  }

  .dwg-rd-hero__eyebrow {
    font-family: 'Inter', sans-serif;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-size: clamp(0.85rem, 1.4vw, 1rem);
    color: var(--rd-hero-eyebrow);
    margin: 0 0 16px;
  }

  .dwg-rd-hero__body {
    font-family: 'Manjari', sans-serif;
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    line-height: 1.55;
    color: var(--rd-hero-text);
    max-width: 34ch;
    margin: 0 0 28px;
  }

  .dwg-rd-hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: 'Manjari', sans-serif;
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 15px 34px;
    background: var(--rd-hero-btn-bg);
    color: var(--rd-hero-btn-text);
    transition: filter 0.2s ease;
  }

  .dwg-rd-hero__btn:hover {
    filter: brightness(1.08);
  }

  /* Media — chef in a large circle, product in a smaller overlapping circle */
  .dwg-rd-hero__media {
    position: relative;
    width: 100%;
    max-width: 520px;
    margin-inline: auto;
    aspect-ratio: 1 / 1;
  }

  .dwg-rd-hero__chef {
    position: absolute;
    inset: 0 0 auto auto;
    width: 78%;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    overflow: hidden;
    background: #f2ead6;
  }

  .dwg-rd-hero__chef-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .dwg-rd-hero__product {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 42%;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    overflow: hidden;
    background: #f7efdc;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.12);
  }

  .dwg-rd-hero__product-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    padding: 8%;
  }

  @media screen and (max-width: 899px) {
    .dwg-rd-hero__media {
      max-width: 380px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "DWG RD: Hero",
  "tag": "section",
  "class": "section--dwg-rd-hero",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "No 1 African Chilli Oil" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Heat, Flavor, Gold Standard" },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Premium chilli oil crafted to elevate every meal with bold, unforgettable flavor.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop From Us" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "image_picker", "id": "chef_image", "label": "Chef image (large circle)" },
    { "type": "image_picker", "id": "product_image", "label": "Product image (small circle)" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#BD8C1E" },
    { "type": "color", "id": "eyebrow_color", "label": "Eyebrow", "default": "#A0341E" },
    { "type": "color", "id": "text_color", "label": "Body text", "default": "#1C1C1C" },
    { "type": "color", "id": "button_background", "label": "Button background", "default": "#A97E0C" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#FFFFFF" }
  ],
  "presets": [{ "name": "DWG RD: Hero" }]
}
{% endschema %}
