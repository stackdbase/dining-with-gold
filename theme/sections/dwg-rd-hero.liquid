{% comment %}
  DWG redesign — Hero slideshow. Rotating slides that cross-fade + pop in
  over each other. Each slide = live text (left or right) + a product
  graphic bleeding to that edge. Respects prefers-reduced-motion.
{% endcomment %}

{% liquid
  assign bg = section.settings.background | default: '#FFFFFF'
  assign heading_color = section.settings.heading_color | default: '#BD8C1E'
  assign eyebrow_color = section.settings.eyebrow_color | default: '#A0341E'
  assign text_color = section.settings.text_color | default: '#1C1C1C'
  assign btn_bg = section.settings.button_background | default: '#A97E0C'
  assign btn_text = section.settings.button_text_color | default: '#FFFFFF'
  assign speed = section.settings.autoplay_speed | default: 5
  assign speed_ms = speed | times: 1000
%}

<section
  class="dwg-rd-hero"
  style="
    --rd-hero-bg: {{ bg }};
    --rd-hero-heading: {{ heading_color }};
    --rd-hero-eyebrow: {{ eyebrow_color }};
    --rd-hero-text: {{ text_color }};
    --rd-hero-btn-bg: {{ btn_bg }};
    --rd-hero-btn-text: {{ btn_text }};
  "
  data-dwg-hero
  data-autoplay="{{ speed_ms }}"
>
  <div class="dwg-rd-hero__stage" id="dwg-hero-{{ section.id }}">
    {% for block in section.blocks %}
      {% liquid
        assign side = block.settings.image_side | default: 'right'
        assign mstyle = block.settings.media_style | default: 'float'
      %}
      <div
        class="dwg-rd-hero__slide dwg-rd-hero__slide--img-{{ side }} dwg-rd-hero__slide--{{ mstyle }}{% if block.settings.compact_media %} dwg-rd-hero__slide--compact{% endif %}{% if forloop.first %} is-active{% endif %}"
        data-slide="{{ forloop.index0 }}"
        {{ block.shopify_attributes }}
      >
        <div class="dwg-rd-hero__content">
          {% if block.settings.eyebrow != blank %}
            <p class="dwg-rd-hero__eyebrow">{{ block.settings.eyebrow }}</p>
          {% endif %}
          {% if block.settings.heading != blank %}
            <h1 class="dwg-rd-hero__heading">{{ block.settings.heading }}</h1>
          {% endif %}
          {% if block.settings.body != blank %}
            <div class="dwg-rd-hero__body">{{ block.settings.body }}</div>
          {% endif %}
          {% if block.settings.button_label != blank %}
            <a class="dwg-rd-hero__btn" href="{{ block.settings.button_link | default: '#' }}">{{ block.settings.button_label }}</a>
          {% endif %}
        </div>

        <div class="dwg-rd-hero__media">
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 1300 | image_tag: class: 'dwg-rd-hero__media-img', widths: '500, 750, 1000, 1300', loading: 'eager', alt: block.settings.heading | default: 'DWG African Chilli Oil' }}
          {% elsif block.settings.fallback_image != blank %}
            <img class="dwg-rd-hero__media-img" src="{{ block.settings.fallback_image | asset_url }}" alt="{{ block.settings.heading | default: 'DWG African Chilli Oil' }}" width="1000" height="1200" loading="eager">
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>

</section>

{% stylesheet %}
  .dwg-rd-hero {
    position: relative;
    background-color: var(--rd-hero-bg);
    padding-block: clamp(24px, 4vw, 56px);
    overflow-x: hidden;
  }

  .dwg-rd-hero__stage {
    display: grid;
  }

  .dwg-rd-hero__slide {
    grid-area: 1 / 1;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(20px, 4vw, 44px);
    align-items: center;
    padding-inline: clamp(20px, 5vw, 48px);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
    z-index: 1;
  }

  .dwg-rd-hero__slide.is-active {
    opacity: 1;
    pointer-events: auto;
    z-index: 2;
  }

  .dwg-rd-hero__content {
    max-width: 720px;
  }

  .dwg-rd-hero__eyebrow {
    font-family: 'Inter', sans-serif;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: clamp(1rem, 1.7vw, 1.375rem);
    color: var(--rd-hero-eyebrow);
    margin: 0 0 22px;
  }

  .dwg-rd-hero__heading {
    font-family: 'Outfit', sans-serif;
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 0.92;
    margin: 0 0 28px;
    font-size: clamp(3.5rem, 9vw, 7.75rem);
    color: var(--rd-hero-heading);
    text-transform: uppercase;
  }

  .dwg-rd-hero__body {
    font-family: 'Manjari', sans-serif;
    font-size: clamp(1.15rem, 1.9vw, 1.5rem);
    line-height: 1.5;
    color: var(--rd-hero-text);
    max-width: 42ch;
    margin: 0 0 34px;
  }

  .dwg-rd-hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: 'Manjari', sans-serif;
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-decoration: none;
    font-size: 1.1rem;
    padding: 17px 42px;
    background: var(--rd-hero-btn-bg);
    color: var(--rd-hero-btn-text);
    transition: filter 0.2s ease;
  }

  .dwg-rd-hero__btn:hover { filter: brightness(1.08); }

  .dwg-rd-hero__media {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .dwg-rd-hero__media-img {
    display: block;
    width: 100%;
    max-width: 520px;
    height: auto;
  }

  /* Fill style — image covers the whole media column, bleeding to the edge
     (used by the gold-panel jar slide). */
  .dwg-rd-hero__slide--fill .dwg-rd-hero__media {
    align-self: stretch;
    min-height: 340px;
  }
  .dwg-rd-hero__slide--fill .dwg-rd-hero__media-img {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }


  @media screen and (min-width: 900px) {
    .dwg-rd-hero__stage { min-height: clamp(520px, 46vw, 660px); }

    .dwg-rd-hero__slide { grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); }

    /* Image on the right → text keeps the page gutter left, image bleeds right */
    .dwg-rd-hero__slide--img-right {
      padding-left: max(clamp(20px, 5vw, 48px), calc((100% - var(--dwg-page-max, 1360px)) / 2 + 48px));
      padding-right: 0;
    }
    .dwg-rd-hero__slide--img-right .dwg-rd-hero__media { order: 2; justify-content: flex-end; }

    /* Image on the left → image bleeds left, text keeps the page gutter right */
    .dwg-rd-hero__slide--img-left {
      padding-right: max(clamp(20px, 5vw, 48px), calc((100% - var(--dwg-page-max, 1360px)) / 2 + 48px));
      padding-left: 0;
    }
    .dwg-rd-hero__slide--img-left .dwg-rd-hero__content { order: 2; }
    .dwg-rd-hero__slide--img-left .dwg-rd-hero__media { order: 1; justify-content: flex-start; }

    .dwg-rd-hero__media-img { max-width: 640px; }
    .dwg-rd-hero__slide--fill .dwg-rd-hero__media { min-height: 0; }

    /* Compact slide: pull the image inward from the edge + up, and bring
       the text inward from the left too, for a tighter, centred balance. */
    .dwg-rd-hero__slide--compact.dwg-rd-hero__slide--img-right .dwg-rd-hero__media {
      justify-content: center;
      padding-right: clamp(24px, 6vw, 110px);
    }
    .dwg-rd-hero__slide--compact .dwg-rd-hero__media-img {
      max-width: 560px;
      transform: translateY(-44px);
    }
    .dwg-rd-hero__slide--compact .dwg-rd-hero__content {
      padding-left: clamp(24px, 7vw, 130px);
    }
  }

  @media screen and (max-width: 899px) {
    .dwg-rd-hero__slide--img-left .dwg-rd-hero__content { order: 2; }
    .dwg-rd-hero__media-img { max-width: 420px; }
    .dwg-rd-hero__slide--fill .dwg-rd-hero__media-img { max-width: none; height: 360px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .dwg-rd-hero__slide { transition: opacity 0.2s ease; transform: none; }
  }
{% endstylesheet %}

<script>
  (function () {
    var root = document.currentScript.previousElementSibling;
    while (root && !(root.hasAttribute && root.hasAttribute('data-dwg-hero'))) {
      root = root.previousElementSibling;
    }
    if (!root) return;

    var slides = Array.prototype.slice.call(root.querySelectorAll('.dwg-rd-hero__slide'));
    if (slides.length < 2) return;

    var i = 0;
    var delay = parseInt(root.getAttribute('data-autoplay'), 10) || 4000;
    var timer = null;

    function show(n) {
      i = (n + slides.length) % slides.length;
      slides.forEach(function (s, idx) { s.classList.toggle('is-active', idx === i); });
    }
    function next() { show(i + 1); }
    function start() { stop(); timer = setInterval(next, delay); }
    function stop() { if (timer) { clearInterval(timer); timer = null; } }

    document.addEventListener('visibilitychange', function () { document.hidden ? stop() : start(); });
    start();
  })();
</script>

{% schema %}
{
  "name": "DWG RD: Hero",
  "tag": "section",
  "class": "section--dwg-rd-hero",
  "settings": [
    { "type": "range", "id": "autoplay_speed", "label": "Autoplay speed (seconds)", "min": 1, "max": 10, "step": 1, "default": 2 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#BD8C1E" },
    { "type": "color", "id": "eyebrow_color", "label": "Eyebrow", "default": "#A0341E" },
    { "type": "color", "id": "text_color", "label": "Body text", "default": "#1C1C1C" },
    { "type": "color", "id": "button_background", "label": "Button background", "default": "#A97E0C" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#FFFFFF" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Heat, Flavor, Gold Standard" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "African Chilli Oil" },
        { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Premium chilli oil crafted to elevate every meal with bold, unforgettable flavor.</p>" },
        { "type": "text", "id": "button_label", "label": "Button label" },
        { "type": "url", "id": "button_link", "label": "Button link" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "fallback_image", "label": "Fallback image asset", "info": "Theme asset filename used if no image is picked." },
        { "type": "select", "id": "image_side", "label": "Image side", "options": [ { "value": "right", "label": "Right" }, { "value": "left", "label": "Left" } ], "default": "right" },
        { "type": "select", "id": "media_style", "label": "Image style", "options": [ { "value": "float", "label": "Float (product on background)" }, { "value": "fill", "label": "Fill (edge-to-edge panel)" } ], "default": "float" },
        { "type": "checkbox", "id": "compact_media", "label": "Bring image inward & up", "default": false }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "DWG RD: Hero",
      "blocks": [
        { "type": "slide", "settings": { "heading": "No 1 African Chilli Oil", "button_label": "Shop From Us", "fallback_image": "dwg-rd-hero-cluster.png", "image_side": "right", "media_style": "float" } },
        { "type": "slide", "settings": { "heading": "African Chilli Oil", "fallback_image": "dwg-rd-elevate-bottle.png", "image_side": "right", "media_style": "float" } },
        { "type": "slide", "settings": { "heading": "African Chilli Oil", "fallback_image": "dwg-rd-hero-jar-panel.jpg", "image_side": "left", "media_style": "fill" } }
      ]
    }
  ]
}
{% endschema %}
