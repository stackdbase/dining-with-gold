{% comment %}
  DWG redesign — cream newsletter band (logo + "Subscribe to Our Newsletter").
  Uses Shopify's customer newsletter form. Remove this section to revert.
{% endcomment %}

{% liquid
  assign bg = section.settings.background | default: '#FBEABC'
  assign text_color = section.settings.text_color | default: '#1C1C1C'
  assign btn_bg = section.settings.button_background | default: '#BD8C1E'
  assign btn_text = section.settings.button_text_color | default: '#FFFFFF'
%}

<section
  class="dwg-rd-news"
  style="
    --rd-nw-bg: {{ bg }};
    --rd-nw-text: {{ text_color }};
    --rd-nw-btn-bg: {{ btn_bg }};
    --rd-nw-btn-text: {{ btn_text }};
  "
>
  <div class="dwg-rd-news__wrap page-width">
    <div class="dwg-rd-news__brand">
      {% if section.settings.logo != blank %}
        {{ section.settings.logo | image_url: width: 400 | image_tag: class: 'dwg-rd-news__logo', widths: '200, 400', loading: 'lazy', alt: 'Dining with Gold' }}
      {% else %}
        <img class="dwg-rd-news__logo" src="{{ 'dwg-rd-logo.png' | asset_url }}" alt="Dining with Gold" width="400" height="316" loading="lazy">
      {% endif %}
      {% if section.settings.brand_text != blank %}
        <p class="dwg-rd-news__brand-text">{{ section.settings.brand_text }}</p>
      {% endif %}
    </div>

    <div class="dwg-rd-news__form-col">
      {% if section.settings.heading != blank %}
        <h2 class="dwg-rd-news__heading">{{ section.settings.heading }}</h2>
      {% endif %}
      {% form 'customer', class: 'dwg-rd-news__form' %}
        {% if form.posted_successfully? %}
          <p class="dwg-rd-news__success">Thanks for subscribing! Watch your inbox for gold.</p>
        {% else %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="dwg-rd-news__field">
            <input
              type="email"
              name="contact[email]"
              class="dwg-rd-news__input"
              placeholder="{{ section.settings.placeholder | default: 'Your email address' }}"
              aria-label="Email"
              required
            >
            <button type="submit" class="dwg-rd-news__btn">{{ section.settings.button_label | default: 'Send' }}</button>
          </div>
        {% endif %}
      {% endform %}
    </div>
  </div>
</section>

{% stylesheet %}
  .dwg-rd-news {
    background-color: var(--rd-nw-bg);
    color: var(--rd-nw-text);
    padding-block: clamp(32px, 5vw, 56px);
  }

  .dwg-rd-news__wrap {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(24px, 4vw, 48px);
    align-items: center;
  }

  @media screen and (min-width: 750px) {
    .dwg-rd-news__wrap {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    }
  }

  .dwg-rd-news__logo {
    width: auto;
    height: 96px;
    object-fit: contain;
    display: block;
  }

  .dwg-rd-news__brand-text {
    font-family: 'Outfit', sans-serif;
    font-size: 1.5rem;
    margin: 12px 0 0;
    color: var(--rd-nw-text);
  }

  .dwg-rd-news__heading {
    font-family: 'Outfit', sans-serif;
    font-weight: 400;
    font-size: clamp(1.35rem, 2.5vw, 1.9rem);
    margin: 0 0 18px;
    color: var(--rd-nw-text);
  }

  .dwg-rd-news__field {
    display: flex;
    background: #fff;
    max-width: 520px;
    overflow: hidden;
    border-radius: 2px;
  }

  .dwg-rd-news__input {
    flex: 1 1 auto;
    border: 0;
    padding: 18px 20px;
    font-family: 'Outfit', sans-serif;
    font-size: 1rem;
    background: transparent;
    color: #1c1c1c;
  }

  .dwg-rd-news__input:focus {
    outline: 2px solid var(--rd-nw-btn-bg);
    outline-offset: -2px;
  }

  .dwg-rd-news__btn {
    flex: 0 0 auto;
    border: 0;
    cursor: pointer;
    padding: 0 30px;
    font-family: 'Outfit', sans-serif;
    font-weight: 600;
    font-size: 1.05rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    background: var(--rd-nw-btn-bg);
    color: var(--rd-nw-btn-text);
    transition: filter 0.2s ease;
  }

  .dwg-rd-news__btn:hover {
    filter: brightness(1.08);
  }

  .dwg-rd-news__success {
    font-family: 'Outfit', sans-serif;
    font-size: 1.1rem;
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "DWG RD: Newsletter",
  "tag": "section",
  "class": "section--dwg-rd-news",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "text", "id": "brand_text", "label": "Brand text", "default": "Dining with Gold" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Subscribe to Our Newsletter" },
    { "type": "text", "id": "placeholder", "label": "Input placeholder", "default": "Your email address" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Send" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background", "label": "Background", "default": "#FBEABC" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1C1C1C" },
    { "type": "color", "id": "button_background", "label": "Button background", "default": "#BD8C1E" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#FFFFFF" }
  ],
  "presets": [{ "name": "DWG RD: Newsletter" }]
}
{% endschema %}
