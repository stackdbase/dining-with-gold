{% comment %}
  DWG redesign, Product hero (PDP). Title + tagline + body + CTA on the
  left, product jar image on the right. Uses the product object; the CTA
  adds to cart. Remove from the product template to revert.
{% endcomment %}

{% liquid
  assign bg = section.settings.background | default: '#FFFFFF'
  assign heading_color = section.settings.heading_color | default: '#BD8C1E'
  assign eyebrow_color = section.settings.eyebrow_color | default: '#B28100'
  assign text_color = section.settings.text_color | default: '#1C1C1C'
  assign btn_bg = section.settings.button_background | default: '#A97E0C'
  assign btn_text = section.settings.button_text_color | default: '#FFFFFF'
  assign heading = section.settings.heading | default: product.title | default: 'African Chilli Oil'
%}

<section
  class="dwg-rd-phero"
  style="--rd-ph-bg: {{ bg }}; --rd-ph-heading: {{ heading_color }}; --rd-ph-eyebrow: {{ eyebrow_color }}; --rd-ph-text: {{ text_color }}; --rd-ph-btn-bg: {{ btn_bg }}; --rd-ph-btn-text: {{ btn_text }};"
>
  <div class="dwg-rd-phero__wrap page-width">
    <div class="dwg-rd-phero__content">
      {%- assign title_parts = heading | split: ' - ' -%}
      <h1 class="dwg-rd-phero__heading">
        {{ title_parts[0] }}
        {%- if title_parts.size > 1 -%}
          <span class="dwg-rd-phero__heading-sub">{{ title_parts | slice: 1, title_parts.size | join: ' - ' }}</span>
        {%- endif -%}
      </h1>
      {% if section.settings.eyebrow != blank %}
        <p class="dwg-rd-phero__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      {% if section.settings.body != blank %}
        <div class="dwg-rd-phero__body">{{ section.settings.body }}</div>
      {% endif %}
      {% if product != blank %}
        {% if product.price != blank %}
          <p class="dwg-rd-phero__price-label">Price Tag</p>
          <p class="dwg-rd-phero__price">
            <span data-price-target>{{ product.price | money }}</span>
            {% if product.compare_at_price > product.price %}
              <s class="dwg-rd-phero__was">{{ product.compare_at_price | money }}</s>
            {% endif %}
          </p>
        {% endif %}

        {% form 'product', product, class: 'dwg-rd-phero__form', id: 'dwg-phero-form' %}
          {% if product.variants.size > 1 %}
            <label class="dwg-rd-phero__vh" for="dwg-phero-variant">Variant</label>
            <select id="dwg-phero-variant" name="id" class="dwg-rd-phero__variants">
              {% for v in product.variants %}
                <option value="{{ v.id }}" {% if v == product.selected_or_first_available_variant %}selected{% endif %} {% unless v.available %}disabled{% endunless %}>
                  {{ v.title }} · {{ v.price | money }}{% unless v.available %} (sold out){% endunless %}
                </option>
              {% endfor %}
            </select>
          {% else %}
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          {% endif %}

          {% if section.settings.show_packs %}
            {% liquid
              assign h1 = section.settings.pack_single_handle | default: 'dwg-travel-chilli-oil'
              assign h2 = section.settings.pack_double_handle | default: 'dwg-travel-chilli-oil-2-pack'
              assign h3 = section.settings.pack_triple_handle | default: 'dwg-travel-chilli-oil-3-pack'
              assign p1 = all_products[h1]
              assign p2 = all_products[h2]
              assign p3 = all_products[h3]
            %}
            <p class="dwg-rd-phero__label">Choose your pack</p>
            <div class="dwg-rd-phero__packs"
                 data-packs
                 data-unit-cents="{{ product.price }}"
                 data-money-sample="{{ product.price | money }}">
              {% if p1 != empty %}
                <a class="dwg-rd-phero__pack{% if product.handle == p1.handle %} is-active{% endif %}" href="{{ p1.url }}"{% if product.handle == p1.handle %} aria-current="true"{% endif %}>
                  <span class="dwg-rd-phero__pack-name">Single Pack</span>
                  <span class="dwg-rd-phero__pack-price">{{ p1.price | money }}</span>
                  <span class="dwg-rd-phero__pack-each">{{ p1.price | money }} each</span>
                </a>
              {% endif %}
              {% if p2 != empty %}
                <a class="dwg-rd-phero__pack{% if product.handle == p2.handle %} is-active{% endif %}" href="{{ p2.url }}"{% if product.handle == p2.handle %} aria-current="true"{% endif %}>
                  <span class="dwg-rd-phero__pack-name">Double Pack</span>
                  <span class="dwg-rd-phero__pack-price">{{ p2.price | money }}</span>
                  <span class="dwg-rd-phero__pack-each">{{ p2.price | divided_by: 2 | money }} each</span>
                </a>
              {% endif %}
              {% if p3 != empty %}
                <a class="dwg-rd-phero__pack{% if product.handle == p3.handle %} is-active{% endif %}" href="{{ p3.url }}"{% if product.handle == p3.handle %} aria-current="true"{% endif %}>
                  {% if section.settings.popular_badge != blank %}<span class="dwg-rd-phero__pack-badge">{{ section.settings.popular_badge }}</span>{% endif %}
                  <span class="dwg-rd-phero__pack-name">3 Pack</span>
                  <span class="dwg-rd-phero__pack-price">{{ p3.price | money }}</span>
                  <span class="dwg-rd-phero__pack-each">{{ p3.price | divided_by: 3 | money }} each</span>
                </a>
              {% endif %}
            </div>
          {% endif %}

          <p class="dwg-rd-phero__label">Quantity</p>
          <div class="dwg-rd-phero__qty" data-qty>
            <button type="button" class="dwg-rd-phero__qty-btn" data-qty-minus aria-label="Decrease quantity">&minus;</button>
            <span class="dwg-rd-phero__qty-num" data-qty-num>1</span>
            <button type="button" class="dwg-rd-phero__qty-btn" data-qty-plus aria-label="Increase quantity">&plus;</button>
          </div>
          <input type="hidden" name="quantity" value="1" data-qty-hidden>

          <div class="dwg-rd-phero__purchase">
            <button type="submit" name="add" class="dwg-rd-phero__btn dwg-rd-phero__btn--add"{% unless product.available %} disabled{% endunless %}>
              {% if product.available %}
                <span>{{ section.settings.button_label | default: 'Add to Cart' }}</span>
                <span class="dwg-rd-phero__btn-sep">|</span>
                <span data-total-target>{{ product.price | money }}</span>
              {% else %}Sold Out{% endif %}
            </button>
          </div>

          {% if product.available %}
            {{ form | payment_button }}
          {% endif %}
        {% endform %}

        {% if section.settings.show_promo %}
          {%- assign promo_prod = section.settings.promo_product -%}
          <div class="dwg-rd-phero__promo" style="--promo1: {{ section.settings.promo_bg_start | default: '#efe7dd' }}; --promo2: {{ section.settings.promo_bg_end | default: '#f2c7b6' }}; --promobtn: {{ section.settings.promo_btn | default: '#e8543f' }};">
            <div class="dwg-rd-phero__promo-text">
              <p class="dwg-rd-phero__promo-heading">{{ section.settings.promo_heading | default: 'The Full Flavour Bundle' }}</p>
              {% if section.settings.promo_subtext != blank %}
                <p class="dwg-rd-phero__promo-sub">{{ section.settings.promo_subtext }}</p>
              {% endif %}
              {% if promo_prod != blank and promo_prod.available %}
                <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" class="dwg-rd-phero__promo-form">
                  <input type="hidden" name="id" value="{{ promo_prod.selected_or_first_available_variant.id }}">
                  <input type="hidden" name="quantity" value="1">
                  <button type="submit" class="dwg-rd-phero__promo-btn">Add to Cart <span class="dwg-rd-phero__btn-sep">|</span> {{ promo_prod.price | money }}</button>
                </form>
              {% else %}
                <a class="dwg-rd-phero__promo-btn" href="{{ section.settings.promo_link | default: routes.all_products_collection_url }}">Shop Now{% if section.settings.promo_price_text != blank %} <span class="dwg-rd-phero__btn-sep">|</span> {{ section.settings.promo_price_text }}{% endif %}</a>
              {% endif %}
            </div>
            {% if section.settings.promo_image != blank %}
              {{ section.settings.promo_image | image_url: width: 800 | image_tag: class: 'dwg-rd-phero__promo-img', widths: '400, 600, 800', loading: 'lazy', alt: section.settings.promo_heading }}
            {% else %}
              <img class="dwg-rd-phero__promo-img" src="{{ 'dwg-rd-flavor-stack.png' | asset_url }}" alt="{{ section.settings.promo_heading | default: 'DWG bundle' }}" width="1179" height="812" loading="lazy">
            {% endif %}
          </div>
        {% endif %}

        {% if section.settings.ingredients != blank %}
          <details class="dwg-rd-phero__acc">
            <summary class="dwg-rd-phero__acc-head">{{ section.settings.ingredients_title | default: 'Ingredients' }}<span class="dwg-rd-phero__acc-icon" aria-hidden="true"></span></summary>
            <div class="dwg-rd-phero__acc-body">{{ section.settings.ingredients }}</div>
          </details>
        {% endif %}

        {%- assign comp = section.settings.companion_product -%}
        {% if comp != blank and comp.available %}
          <div class="dwg-rd-phero__bwith">
            <div class="dwg-rd-phero__bwith-info">
              <p class="dwg-rd-phero__bwith-title">Buy It With</p>
              <p class="dwg-rd-phero__bwith-name">{{ comp.title }}</p>
              <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" class="dwg-rd-phero__bwith-form">
                <input type="hidden" name="id" value="{{ comp.selected_or_first_available_variant.id }}">
                <input type="hidden" name="quantity" value="1">
                <button type="submit" class="dwg-rd-phero__bwith-btn">Add to Cart <span class="dwg-rd-phero__btn-sep">|</span> {{ comp.price | money }}</button>
              </form>
            </div>
            {% if comp.featured_image %}
              <img class="dwg-rd-phero__bwith-img" src="{{ comp.featured_image | image_url: width: 240 }}" alt="{{ comp.title }}" width="120" height="120" loading="lazy">
            {% endif %}
          </div>
        {% endif %}

        {% if section.settings.show_badges %}
          <div class="dwg-rd-phero__badges">
            <div class="dwg-rd-phero__badge">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h11v8H3zM14 10h4l3 3v2h-7zM7 18a2 2 0 100-4 2 2 0 000 4zM18 18a2 2 0 100-4 2 2 0 000 4z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
              <span>{{ section.settings.badge_1 | default: 'Free Shipping Over £49' }}</span>
            </div>
            <div class="dwg-rd-phero__badge">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h16M4 8l2-3h12l2 3M4 8v11h16V8M9 12h6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
              <span>{{ section.settings.badge_2 | default: 'Shelf Stable' }}</span>
            </div>
            <div class="dwg-rd-phero__badge">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2v20M4 6l16 12M20 6L4 18M12 2l-3 3M12 2l3 3M12 22l-3-3M12 22l3-3M3 9l4 1M3 15l4-1M21 9l-4 1M21 15l-4-1" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
              <span>{{ section.settings.badge_3 | default: 'Do Not Refrigerate' }}</span>
            </div>
          </div>
        {% endif %}
      {% else %}
        <a class="dwg-rd-phero__btn dwg-rd-phero__btn--add" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | default: 'Check Us Out' }}</a>
      {% endif %}
    </div>

    <div class="dwg-rd-phero__media">
      {% liquid
        assign t = product.title | downcase
        assign main_img = 'dwg-rd-shop-single.png'
        if t contains 'jar'
          assign main_img = 'dwg-rd-shop-jar.png'
        elsif t contains '3 pack' or t contains '3-pack' or t contains 'triple' or t contains 'trio' or t contains 'three' or t contains 'bundle'
          assign main_img = 'dwg-rd-shop-trio.png'
        elsif t contains 'pack' or t contains 'double' or t contains 'duo' or t contains 'twin' or t contains '2 pack'
          assign main_img = 'dwg-rd-shop-pack.png'
        endif
        assign fallback_imgs = main_img | append: ',dwg-rd-hero-bottle-chillies.png,dwg-rd-more-bottle.png' | split: ','
        assign use_product_imgs = false
        if section.settings.use_design_images == false and product != blank and product.images.size > 0
          assign use_product_imgs = true
        endif
      %}

      <div class="dwg-rd-phero__gallery" data-gallery>
        <button type="button" class="dwg-rd-phero__g-arrow dwg-rd-phero__g-arrow--prev" data-g-prev aria-label="Previous image">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="dwg-rd-phero__stage" data-g-stage>
          {% if use_product_imgs %}
            {% for img in product.images %}
              <img class="dwg-rd-phero__img{% if forloop.first %} is-active{% endif %}" data-g-slide="{{ forloop.index0 }}" src="{{ img | image_url: width: 900 }}" alt="{{ heading }}" width="600" height="800" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
            {% endfor %}
          {% else %}
            {% for f in fallback_imgs %}
              <img class="dwg-rd-phero__img{% if forloop.first %} is-active{% endif %}" data-g-slide="{{ forloop.index0 }}" src="{{ f | asset_url }}" alt="{{ heading }}" width="600" height="800" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
            {% endfor %}
          {% endif %}
        </div>
        <button type="button" class="dwg-rd-phero__g-arrow dwg-rd-phero__g-arrow--next" data-g-next aria-label="Next image">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>

      <div class="dwg-rd-phero__thumbs" data-g-thumbs>
        {% if use_product_imgs %}
          {% for img in product.images %}
            <button type="button" class="dwg-rd-phero__thumb{% if forloop.first %} is-active{% endif %}" data-g-thumb="{{ forloop.index0 }}" aria-label="View image {{ forloop.index }}">
              <img src="{{ img | image_url: width: 220 }}" alt="" width="110" height="110" loading="lazy">
            </button>
          {% endfor %}
        {% else %}
          {% for f in fallback_imgs %}
            <button type="button" class="dwg-rd-phero__thumb{% if forloop.first %} is-active{% endif %}" data-g-thumb="{{ forloop.index0 }}" aria-label="View image {{ forloop.index }}">
              <img src="{{ f | asset_url }}" alt="" width="110" height="110" loading="lazy">
            </button>
          {% endfor %}
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .dwg-rd-phero {
    background: var(--rd-ph-bg);
    padding-block: clamp(16px, 3vw, 40px);
  }

  .dwg-rd-phero__wrap {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(24px, 5vw, 56px);
    align-items: center;
  }

  @media screen and (min-width: 900px) {
    .dwg-rd-phero__wrap { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: center; }
    .dwg-rd-phero__media { order: 0; align-self: center; }
    .dwg-rd-phero__content { align-self: center; }
  }

  .dwg-rd-phero__heading {
    font-family: 'Outfit', sans-serif;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 1.05;
    font-size: clamp(1.6rem, 2.4vw, 2.15rem);
    color: var(--rd-ph-heading);
    margin: 0 0 12px;
  }
  .dwg-rd-phero__heading-sub {
    display: block;
    font-weight: 400;
    font-size: 0.62em;
    color: rgba(28, 28, 28, 0.55);
    margin-top: 4px;
  }

  .dwg-rd-phero__eyebrow {
    font-family: 'Inter', sans-serif;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-size: clamp(0.82rem, 1.2vw, 0.95rem);
    color: var(--rd-ph-eyebrow);
    margin: 0 0 12px;
  }

  .dwg-rd-phero__body {
    font-family: 'Manjari', sans-serif;
    font-size: clamp(0.95rem, 1.3vw, 1.1rem);
    line-height: 1.45;
    color: var(--rd-ph-text);
    max-width: 44ch;
    margin: 0 0 16px;
  }

  .dwg-rd-phero__form { margin: 0; }

  .dwg-rd-phero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0;
    cursor: pointer;
    font-family: 'Manjari', sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    font-size: clamp(0.85rem, 1vw, 0.95rem);
    padding: clamp(10px, 1.1vw, 13px) clamp(18px, 2vw, 26px);
    background: var(--rd-ph-btn-bg);
    color: var(--rd-ph-btn-text);
    text-decoration: none;
    border-radius: 40px;
    transition: filter 0.2s ease;
  }

  .dwg-rd-phero__btn:hover { filter: brightness(1.08); }
  .dwg-rd-phero__btn:disabled { opacity: 0.5; cursor: not-allowed; }

  .dwg-rd-phero__price {
    font-family: 'Outfit', sans-serif;
    font-weight: 600;
    font-size: clamp(1.3rem, 2vw, 1.65rem);
    color: var(--rd-ph-text);
    margin: 0 0 10px;
    display: flex;
    align-items: baseline;
    gap: 12px;
  }
  .dwg-rd-phero__was { color: rgba(28,28,28,0.45); font-weight: 400; font-size: 0.7em; }

  .dwg-rd-phero__variants {
    display: block;
    width: 100%;
    max-width: 340px;
    padding: 14px 16px;
    margin: 0 0 18px;
    border: 1.5px solid rgba(28, 28, 28, 0.25);
    border-radius: 8px;
    font-family: 'Outfit', sans-serif;
    font-size: 1rem;
    background: #fff;
  }

  /* Purchase controls sit in one balanced, capped-width column */
  .dwg-rd-phero__form { max-width: 440px; }

  .dwg-rd-phero__purchase {
    display: flex;
    align-items: stretch;
    gap: 12px;
    margin-bottom: 12px;
  }

  .dwg-rd-phero__label {
    font-family: 'Outfit', sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    font-size: 0.82rem;
    color: var(--rd-ph-text);
    margin: 10px 0 6px;
  }

  /* Pack chooser, always 3 across on one line */
  .dwg-rd-phero__packs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; max-width: 440px; }
  .dwg-rd-phero__pack {
    position: relative; text-align: left; cursor: pointer; background: #fff; text-decoration: none;
    border: 1.5px solid rgba(28,28,28,0.18); border-radius: 10px; padding: 9px 9px 8px;
    display: flex; flex-direction: column; gap: 2px; transition: border-color .2s, box-shadow .2s;
  }
  .dwg-rd-phero__pack:hover { border-color: var(--rd-ph-btn-bg); }
  .dwg-rd-phero__pack.is-active { border-color: var(--rd-ph-btn-bg); box-shadow: 0 0 0 1px var(--rd-ph-btn-bg); background: #fdf7ec; }
  .dwg-rd-phero__pack-name { font-family: 'Outfit', sans-serif; font-weight: 600; font-size: 0.8rem; line-height: 1.1; color: var(--rd-ph-text); }
  .dwg-rd-phero__pack-price { font-family: 'Outfit', sans-serif; font-weight: 700; font-size: 0.95rem; color: var(--rd-ph-text); }
  .dwg-rd-phero__pack-each { font-family: 'Manjari', sans-serif; font-size: 0.68rem; color: rgba(28,28,28,0.5); }
  .dwg-rd-phero__pack-badge {
    position: absolute; top: -10px; right: 8px; background: #1c1c1c; color: #fff;
    font-family: 'Inter', sans-serif; font-weight: 700; font-size: 0.6rem; letter-spacing: 0.04em;
    padding: 3px 8px; border-radius: 6px; text-transform: uppercase;
  }

  /* Circular quantity stepper */
  .dwg-rd-phero__qty {
    display: flex; align-items: center; justify-content: space-between;
    max-width: 440px; border: 1.5px solid rgba(28,28,28,0.18);
    border-radius: 12px; padding: 5px 10px;
  }
  .dwg-rd-phero__qty-btn {
    width: 34px; height: 34px; border-radius: 50%;
    border: 1.5px solid rgba(28,28,28,0.35); background: #fff; color: #1c1c1c;
    font-size: 1.2rem; line-height: 1; cursor: pointer; display: flex; align-items: center; justify-content: center;
    transition: background .2s, color .2s;
  }
  .dwg-rd-phero__qty-btn:hover { background: #1c1c1c; color: #fff; border-color: #1c1c1c; }
  .dwg-rd-phero__qty-num {
    min-width: 36px; height: 36px; border-radius: 50%; background: var(--rd-ph-btn-bg); color: #fff;
    font-family: 'Outfit', sans-serif; font-weight: 700; font-size: 1rem;
    display: flex; align-items: center; justify-content: center;
  }

  .dwg-rd-phero__purchase { margin-bottom: 10px; }
  .dwg-rd-phero__btn--add { flex: 1 1 auto; gap: 10px; }
  .dwg-rd-phero__btn-sep { opacity: 0.55; }

  /* Shopify dynamic checkout (Buy Now / Shop Pay) */
  .dwg-rd-phero__form .shopify-payment-button { margin-top: 0; }
  .dwg-rd-phero__form .shopify-payment-button__button--unbranded {
    background: #1c1c1c;
    border-radius: 40px;
    font-family: 'Manjari', sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    padding: 14px;
    min-height: 0;
  }

  .dwg-rd-phero__vh { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

  .dwg-rd-phero__media { display: block; order: -1; }

  .dwg-rd-phero__img {
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: clamp(320px, 44vw, 460px);
    object-fit: contain;
    filter: drop-shadow(0 20px 44px rgba(0, 0, 0, 0.16));
  }

  /* Gallery */
  .dwg-rd-phero__gallery { position: relative; display: flex; align-items: center; justify-content: center; gap: clamp(6px, 1.5vw, 18px); }
  .dwg-rd-phero__stage {
    position: relative; flex: 1 1 auto;
    min-height: clamp(320px, 44vw, 460px);
    display: flex; align-items: center; justify-content: center;
  }
  .dwg-rd-phero__stage .dwg-rd-phero__img { position: absolute; opacity: 0; transition: opacity 0.35s ease; pointer-events: none; }
  .dwg-rd-phero__stage .dwg-rd-phero__img.is-active { position: relative; opacity: 1; pointer-events: auto; }

  .dwg-rd-phero__g-arrow {
    flex: 0 0 auto; width: clamp(42px, 5vw, 54px); height: clamp(42px, 5vw, 54px);
    border: 0; border-radius: 50%; background: #f0e2c2; color: #1c1c1c;
    cursor: pointer; display: flex; align-items: center; justify-content: center; transition: filter .2s;
  }
  .dwg-rd-phero__g-arrow--next { background: var(--rd-ph-btn-bg); color: #fff; }
  .dwg-rd-phero__g-arrow svg { width: 22px; height: 22px; }
  .dwg-rd-phero__g-arrow:hover { filter: brightness(1.06); }

  .dwg-rd-phero__thumbs { display: flex; gap: clamp(10px, 1.5vw, 16px); justify-content: center; margin-top: 18px; flex-wrap: wrap; }
  .dwg-rd-phero__thumb {
    border: 2px solid transparent; border-radius: 14px; overflow: hidden; padding: 0;
    background: #faf7f2; cursor: pointer; width: clamp(72px, 12vw, 120px); aspect-ratio: 1 / 1;
  }
  .dwg-rd-phero__thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .dwg-rd-phero__thumb.is-active { border-color: var(--rd-ph-btn-bg); }

  .dwg-rd-phero__price-label { font-family: 'Manjari', sans-serif; color: rgba(28,28,28,0.5); margin: 0 0 4px; }

  /* Ingredients accordion */
  .dwg-rd-phero__acc {
    max-width: 440px; border: 1.5px solid rgba(28,28,28,0.18);
    border-radius: 40px; padding: 2px 6px; margin-top: 12px;
  }
  .dwg-rd-phero__acc[open] { border-radius: 18px; }
  .dwg-rd-phero__acc-head {
    list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between;
    font-family: 'Outfit', sans-serif; font-weight: 700; text-transform: uppercase; letter-spacing: 0.03em;
    font-size: 0.9rem; color: var(--rd-ph-text); padding: 10px 14px;
  }
  .dwg-rd-phero__acc-head::-webkit-details-marker { display: none; }
  .dwg-rd-phero__acc-icon { position: relative; width: 20px; height: 20px; flex: 0 0 auto; }
  .dwg-rd-phero__acc-icon::before,
  .dwg-rd-phero__acc-icon::after { content: ''; position: absolute; background: var(--rd-ph-text); }
  .dwg-rd-phero__acc-icon::before { top: 9px; left: 2px; width: 16px; height: 2px; }
  .dwg-rd-phero__acc-icon::after { top: 2px; left: 9px; width: 2px; height: 16px; transition: transform .2s; }
  .dwg-rd-phero__acc[open] .dwg-rd-phero__acc-icon::after { transform: scaleY(0); }
  .dwg-rd-phero__acc-body {
    font-family: 'Manjari', sans-serif; font-size: 1rem; line-height: 1.55;
    color: rgba(28,28,28,0.8); padding: 0 16px 16px;
  }

  /* Buy It With */
  .dwg-rd-phero__bwith {
    max-width: 440px; margin-top: 12px; display: flex; align-items: center; gap: 14px;
    background: #f7ecd9;
    border-radius: 16px; padding: 12px 16px;
  }
  .dwg-rd-phero__bwith-info { flex: 1 1 auto; min-width: 0; }
  .dwg-rd-phero__bwith-title { font-family: 'Outfit', sans-serif; font-weight: 700; font-size: 1.05rem; margin: 0 0 4px; color: var(--rd-ph-text); }
  .dwg-rd-phero__bwith-name { font-family: 'Manjari', sans-serif; font-size: 0.95rem; color: rgba(28,28,28,0.7); margin: 0 0 12px; }
  .dwg-rd-phero__bwith-btn {
    border: 0; cursor: pointer; width: 100%;
    font-family: 'Manjari', sans-serif; font-weight: 700; text-transform: uppercase; letter-spacing: 0.02em;
    font-size: 0.95rem; padding: 12px 18px; border-radius: 40px;
    background: var(--rd-ph-btn-bg); color: #fff; transition: filter .2s;
  }
  .dwg-rd-phero__bwith-btn:hover { filter: brightness(1.06); }
  .dwg-rd-phero__bwith-img { flex: 0 0 auto; width: clamp(72px, 16vw, 110px); height: auto; object-fit: contain; }

  /* Trust badges */
  .dwg-rd-phero__badges { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px; max-width: 440px; margin-top: 12px; }
  .dwg-rd-phero__badge {
    background: var(--rd-ph-btn-bg); color: #fff; border-radius: 12px; padding: 10px 6px;
    display: flex; flex-direction: column; align-items: center; gap: 6px; text-align: center;
  }
  .dwg-rd-phero__badge svg { width: 24px; height: 24px; }
  .dwg-rd-phero__badge span { font-family: 'Manjari', sans-serif; font-weight: 700; font-size: 0.72rem; line-height: 1.15; }

  /* Bundle promo card (inside the pricing column, under Add to Cart) */
  .dwg-rd-phero__promo {
    position: relative; overflow: hidden; max-width: 440px; margin-top: 12px;
    border-radius: 14px; padding: 12px 14px;
    background: linear-gradient(105deg, var(--promo1) 0%, var(--promo2) 100%);
    display: flex; align-items: center; gap: 10px;
  }
  .dwg-rd-phero__promo-text { flex: 1 1 auto; min-width: 0; }
  .dwg-rd-phero__promo-heading {
    font-family: 'Outfit', sans-serif; font-weight: 800; text-transform: uppercase;
    font-size: clamp(0.9rem, 1.3vw, 1.05rem); line-height: 1.05; color: #1c1c1c; margin: 0 0 4px;
  }
  .dwg-rd-phero__promo-sub {
    font-family: 'Manjari', sans-serif; font-size: 0.8rem; line-height: 1.3;
    color: rgba(28,28,28,0.6); margin: 0 0 9px;
  }
  .dwg-rd-phero__promo-form { margin: 0; }
  .dwg-rd-phero__promo-btn {
    display: inline-flex; align-items: center; gap: 8px; border: 0; cursor: pointer;
    font-family: 'Manjari', sans-serif; font-weight: 700; font-size: 0.82rem;
    padding: 9px 18px; border-radius: 9px; background: var(--promobtn); color: #fff; text-decoration: none;
    transition: filter 0.2s ease;
  }
  .dwg-rd-phero__promo-btn:hover { filter: brightness(1.06); }
  .dwg-rd-phero__promo-img { flex: 0 0 auto; width: clamp(110px, 32%, 180px); height: auto; object-fit: contain; }

  /* Mobile/tablet: purchase controls span full width (no 440px left-cap) */
  @media screen and (max-width: 899px) {
    .dwg-rd-phero__form,
    .dwg-rd-phero__packs,
    .dwg-rd-phero__qty,
    .dwg-rd-phero__acc,
    .dwg-rd-phero__bwith,
    .dwg-rd-phero__badges,
    .dwg-rd-phero__promo { max-width: none; }
  }
{% endstylesheet %}

<script>
  (function () {
    document.querySelectorAll('.dwg-rd-phero').forEach(function (root) {
      // ── Image gallery ──
      var stage = root.querySelector('[data-g-stage]');
      if (stage) {
        var slides = Array.prototype.slice.call(stage.querySelectorAll('.dwg-rd-phero__img'));
        var thumbs = Array.prototype.slice.call(root.querySelectorAll('[data-g-thumb]'));
        var gi = 0;
        function goTo(n) {
          if (!slides.length) return;
          gi = (n + slides.length) % slides.length;
          slides.forEach(function (s, i) { s.classList.toggle('is-active', i === gi); });
          thumbs.forEach(function (t, i) { t.classList.toggle('is-active', i === gi); });
        }
        var prev = root.querySelector('[data-g-prev]');
        var next = root.querySelector('[data-g-next]');
        if (prev) prev.addEventListener('click', function () { goTo(gi - 1); });
        if (next) next.addEventListener('click', function () { goTo(gi + 1); });
        thumbs.forEach(function (t) {
          t.addEventListener('click', function () { goTo(parseInt(t.getAttribute('data-g-thumb'), 10)); });
        });
      }

      // ── Pack chooser + quantity + live total ──
      var packsWrap = root.querySelector('[data-packs]');
      var qtyWrap = root.querySelector('[data-qty]');
      var qtyHidden = root.querySelector('[data-qty-hidden]');
      var qtyNum = root.querySelector('[data-qty-num]');
      var priceTarget = root.querySelector('[data-price-target]');
      var totalTarget = root.querySelector('[data-total-target]');

      // money formatter derived from a sample like "€12.00" / "£12.00" / "$12.00"
      var unitCents = 0, prefix = '', suffix = '';
      var moneySrc = packsWrap || qtyWrap;
      if (packsWrap) {
        unitCents = parseInt(packsWrap.getAttribute('data-unit-cents'), 10) || 0;
        var sample = packsWrap.getAttribute('data-money-sample') || '';
        var m = sample.match(/^([^\d]*)[\d.,]+([^\d]*)$/);
        if (m) { prefix = m[1]; suffix = m[2]; }
      }
      function money(cents) {
        return prefix + (cents / 100).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + suffix;
      }

      var qty = 1;
      function refresh() {
        if (qty < 1) qty = 1;
        if (qtyHidden) qtyHidden.value = qty;
        if (qtyNum) qtyNum.textContent = qty;
        if (unitCents) {
          var t = money(unitCents * qty);
          if (priceTarget) priceTarget.textContent = t;
          if (totalTarget) totalTarget.textContent = t;
        }
      }

      // Pack tabs are links to each pack's own product page (no qty behaviour).
      if (qtyWrap) {
        var minus = qtyWrap.querySelector('[data-qty-minus]');
        var plus = qtyWrap.querySelector('[data-qty-plus]');
        if (minus) minus.addEventListener('click', function () { qty -= 1; refresh(); });
        if (plus) plus.addEventListener('click', function () { qty += 1; refresh(); });
      }
      refresh();
    });
  })();
</script>

