{% comment %}
  DWG redesign — Product hero (PDP). Title + tagline + body + CTA on the
  left, product jar image on the right. Uses the product object; the CTA
  adds to cart. Remove from the product template to revert.
{% endcomment %}

{% liquid
  assign bg = section.settings.background | default: '#FFFFFF'
  assign heading_color = section.settings.heading_color | default: '#BD8C1E'
  assign eyebrow_color = section.settings.eyebrow_color | default: '#B28100'
  assign text_color = section.settings.text_color | default: '#1C1C1C'
  assign btn_bg = section.settings.button_background | default: '#A97E0C'
  assign btn_text = section.settings.button_text_color | default: '#FFFFFF'
  assign heading = section.settings.heading | default: product.title | default: 'African Chilli Oil'
%}

<section
  class="dwg-rd-phero"
  style="--rd-ph-bg: {{ bg }}; --rd-ph-heading: {{ heading_color }}; --rd-ph-eyebrow: {{ eyebrow_color }}; --rd-ph-text: {{ text_color }}; --rd-ph-btn-bg: {{ btn_bg }}; --rd-ph-btn-text: {{ btn_text }};"
>
  <div class="dwg-rd-phero__wrap page-width">
    <div class="dwg-rd-phero__content">
      <h1 class="dwg-rd-phero__heading">{{ heading }}</h1>
      {% if section.settings.eyebrow != blank %}
        <p class="dwg-rd-phero__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      {% if section.settings.body != blank %}
        <div class="dwg-rd-phero__body">{{ section.settings.body }}</div>
      {% endif %}
      {% if product != blank %}
        {% if product.price != blank %}
          <p class="dwg-rd-phero__price-label">Price Tag</p>
          <p class="dwg-rd-phero__price">
            <span data-price-target>{{ product.price | money }}</span>
            {% if product.compare_at_price > product.price %}
              <s class="dwg-rd-phero__was">{{ product.compare_at_price | money }}</s>
            {% endif %}
          </p>
        {% endif %}

        {% form 'product', product, class: 'dwg-rd-phero__form', id: 'dwg-phero-form' %}
          {% if product.variants.size > 1 %}
            <label class="dwg-rd-phero__vh" for="dwg-phero-variant">Variant</label>
            <select id="dwg-phero-variant" name="id" class="dwg-rd-phero__variants">
              {% for v in product.variants %}
                <option value="{{ v.id }}" {% if v == product.selected_or_first_available_variant %}selected{% endif %} {% unless v.available %}disabled{% endunless %}>
                  {{ v.title }} · {{ v.price | money }}{% unless v.available %} (sold out){% endunless %}
                </option>
              {% endfor %}
            </select>
          {% else %}
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          {% endif %}

          <div class="dwg-rd-phero__bundles" data-bundles>
            <button type="button" class="dwg-rd-phero__bundle is-active" data-bundle-qty="1" data-bundle-price="{{ product.price | money }}">
              <span class="dwg-rd-phero__bundle-name">Single Purchase</span>
              <span class="dwg-rd-phero__bundle-price">{{ product.price | money }}</span>
            </button>
            <button type="button" class="dwg-rd-phero__bundle" data-bundle-qty="2" data-bundle-price="{{ product.price | times: 2 | money }}">
              <span class="dwg-rd-phero__bundle-name">Double Pack</span>
              <span class="dwg-rd-phero__bundle-price">{{ product.price | times: 2 | money }}</span>
            </button>
          </div>

          <input type="hidden" name="quantity" value="1" data-qty-hidden>

          <div class="dwg-rd-phero__purchase">
            <button type="submit" name="add" class="dwg-rd-phero__btn dwg-rd-phero__btn--add"{% unless product.available %} disabled{% endunless %}>
              {% if product.available %}{{ section.settings.button_label | default: 'Add to Cart' }}{% else %}Sold Out{% endif %}
            </button>
          </div>

          {% if product.available %}
            {{ form | payment_button }}
          {% endif %}
        {% endform %}
      {% else %}
        <a class="dwg-rd-phero__btn dwg-rd-phero__btn--add" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | default: 'Check Us Out' }}</a>
      {% endif %}
    </div>

    <div class="dwg-rd-phero__media">
      {% liquid
        assign t = product.title | downcase
        assign main_img = 'dwg-rd-shop-bottle.png'
        if t contains 'jar'
          assign main_img = 'dwg-rd-shop-jar.png'
        elsif t contains '3 pack' or t contains '3-pack' or t contains 'triple' or t contains 'trio' or t contains 'three' or t contains 'bundle'
          assign main_img = 'dwg-rd-shop-trio.png'
        elsif t contains 'pack' or t contains 'double' or t contains 'duo' or t contains 'twin' or t contains '2 pack'
          assign main_img = 'dwg-rd-shop-pack.png'
        endif
        assign fallback_imgs = main_img | append: ',dwg-rd-hero-bottle-chillies.png,dwg-rd-more-bottle.png' | split: ','
        assign use_product_imgs = false
        if section.settings.use_design_images == false and product != blank and product.images.size > 0
          assign use_product_imgs = true
        endif
      %}

      <div class="dwg-rd-phero__gallery" data-gallery>
        <button type="button" class="dwg-rd-phero__g-arrow dwg-rd-phero__g-arrow--prev" data-g-prev aria-label="Previous image">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="dwg-rd-phero__stage" data-g-stage>
          {% if use_product_imgs %}
            {% for img in product.images %}
              <img class="dwg-rd-phero__img{% if forloop.first %} is-active{% endif %}" data-g-slide="{{ forloop.index0 }}" src="{{ img | image_url: width: 900 }}" alt="{{ heading }}" width="600" height="800" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
            {% endfor %}
          {% else %}
            {% for f in fallback_imgs %}
              <img class="dwg-rd-phero__img{% if forloop.first %} is-active{% endif %}" data-g-slide="{{ forloop.index0 }}" src="{{ f | asset_url }}" alt="{{ heading }}" width="600" height="800" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
            {% endfor %}
          {% endif %}
        </div>
        <button type="button" class="dwg-rd-phero__g-arrow dwg-rd-phero__g-arrow--next" data-g-next aria-label="Next image">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>

      <div class="dwg-rd-phero__thumbs" data-g-thumbs>
        {% if use_product_imgs %}
          {% for img in product.images %}
            <button type="button" class="dwg-rd-phero__thumb{% if forloop.first %} is-active{% endif %}" data-g-thumb="{{ forloop.index0 }}" aria-label="View image {{ forloop.index }}">
              <img src="{{ img | image_url: width: 220 }}" alt="" width="110" height="110" loading="lazy">
            </button>
          {% endfor %}
        {% else %}
          {% for f in fallback_imgs %}
            <button type="button" class="dwg-rd-phero__thumb{% if forloop.first %} is-active{% endif %}" data-g-thumb="{{ forloop.index0 }}" aria-label="View image {{ forloop.index }}">
              <img src="{{ f | asset_url }}" alt="" width="110" height="110" loading="lazy">
            </button>
          {% endfor %}
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .dwg-rd-phero {
    background: var(--rd-ph-bg);
    padding-block: clamp(24px, 4vw, 56px);
  }

  .dwg-rd-phero__wrap {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(24px, 5vw, 56px);
    align-items: center;
  }

  @media screen and (min-width: 900px) {
    .dwg-rd-phero__wrap { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  }

  .dwg-rd-phero__heading {
    font-family: 'Outfit', sans-serif;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 0.98;
    font-size: clamp(2.25rem, 4.4vw, 3.75rem);
    color: var(--rd-ph-heading);
    margin: 0 0 22px;
  }

  .dwg-rd-phero__eyebrow {
    font-family: 'Inter', sans-serif;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-size: clamp(0.9rem, 1.4vw, 1.1rem);
    color: var(--rd-ph-eyebrow);
    margin: 0 0 18px;
  }

  .dwg-rd-phero__body {
    font-family: 'Manjari', sans-serif;
    font-size: clamp(1.05rem, 1.6vw, 1.3rem);
    line-height: 1.5;
    color: var(--rd-ph-text);
    max-width: 42ch;
    margin: 0 0 30px;
  }

  .dwg-rd-phero__form { margin: 0; }

  .dwg-rd-phero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0;
    cursor: pointer;
    font-family: 'Manjari', sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    font-size: clamp(0.9rem, 1.1vw, 1rem);
    padding: clamp(12px, 1.4vw, 15px) clamp(20px, 2.4vw, 30px);
    background: var(--rd-ph-btn-bg);
    color: var(--rd-ph-btn-text);
    text-decoration: none;
    border-radius: 40px;
    transition: filter 0.2s ease;
  }

  .dwg-rd-phero__btn:hover { filter: brightness(1.08); }
  .dwg-rd-phero__btn:disabled { opacity: 0.5; cursor: not-allowed; }

  .dwg-rd-phero__price {
    font-family: 'Outfit', sans-serif;
    font-weight: 600;
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    color: var(--rd-ph-text);
    margin: 0 0 22px;
    display: flex;
    align-items: baseline;
    gap: 12px;
  }
  .dwg-rd-phero__was { color: rgba(28,28,28,0.45); font-weight: 400; font-size: 0.7em; }

  .dwg-rd-phero__variants {
    display: block;
    width: 100%;
    max-width: 340px;
    padding: 14px 16px;
    margin: 0 0 18px;
    border: 1.5px solid rgba(28, 28, 28, 0.25);
    border-radius: 8px;
    font-family: 'Outfit', sans-serif;
    font-size: 1rem;
    background: #fff;
  }

  /* Purchase controls sit in one balanced, capped-width column */
  .dwg-rd-phero__form { max-width: 440px; }

  .dwg-rd-phero__purchase {
    display: flex;
    align-items: stretch;
    gap: 12px;
    margin-bottom: 12px;
  }

  .dwg-rd-phero__qty {
    display: inline-flex;
    align-items: center;
    border: 1.5px solid #1c1c1c;
    border-radius: 40px;
    overflow: hidden;
    flex: 0 0 auto;
    background: #1c1c1c;
  }
  .dwg-rd-phero__qty-btn {
    border: 0;
    background: #1c1c1c;
    cursor: pointer;
    width: 40px;
    align-self: stretch;
    font-size: 1.15rem;
    color: #ffffff;
    font-family: 'Outfit', sans-serif;
  }
  .dwg-rd-phero__qty-input {
    width: 40px;
    text-align: center;
    font-family: 'Outfit', sans-serif;
    font-size: 1rem;
    background: #1c1c1c !important;
    color: #ffffff !important;
    border: 0 !important;
    border-radius: 0 !important;
    box-shadow: none !important;
    appearance: none;
    -moz-appearance: textfield;
  }
  .dwg-rd-phero__qty-input:focus,
  .dwg-rd-phero__qty-input:focus-visible { outline: none; background: #1c1c1c !important; }
  .dwg-rd-phero__qty-input::-webkit-outer-spin-button,
  .dwg-rd-phero__qty-input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }

  .dwg-rd-phero__btn--add { flex: 1 1 auto; }

  /* Shopify dynamic checkout (Buy Now / Shop Pay) */
  .dwg-rd-phero__form .shopify-payment-button { margin-top: 0; }
  .dwg-rd-phero__form .shopify-payment-button__button--unbranded {
    background: #1c1c1c;
    border-radius: 40px;
    font-family: 'Manjari', sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    padding: 14px;
    min-height: 0;
  }

  .dwg-rd-phero__vh { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

  .dwg-rd-phero__media { display: block; }

  .dwg-rd-phero__img {
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: clamp(320px, 44vw, 460px);
    object-fit: contain;
    filter: drop-shadow(0 20px 44px rgba(0, 0, 0, 0.16));
  }

  /* Gallery */
  .dwg-rd-phero__gallery { position: relative; display: flex; align-items: center; justify-content: center; gap: clamp(6px, 1.5vw, 18px); }
  .dwg-rd-phero__stage {
    position: relative; flex: 1 1 auto;
    min-height: clamp(320px, 44vw, 460px);
    display: flex; align-items: center; justify-content: center;
  }
  .dwg-rd-phero__stage .dwg-rd-phero__img { position: absolute; opacity: 0; transition: opacity 0.35s ease; pointer-events: none; }
  .dwg-rd-phero__stage .dwg-rd-phero__img.is-active { position: relative; opacity: 1; pointer-events: auto; }

  .dwg-rd-phero__g-arrow {
    flex: 0 0 auto; width: clamp(42px, 5vw, 54px); height: clamp(42px, 5vw, 54px);
    border: 0; border-radius: 50%; background: #f0e2c2; color: #1c1c1c;
    cursor: pointer; display: flex; align-items: center; justify-content: center; transition: filter .2s;
  }
  .dwg-rd-phero__g-arrow--next { background: var(--rd-ph-btn-bg); color: #fff; }
  .dwg-rd-phero__g-arrow svg { width: 22px; height: 22px; }
  .dwg-rd-phero__g-arrow:hover { filter: brightness(1.06); }

  .dwg-rd-phero__thumbs { display: flex; gap: clamp(10px, 1.5vw, 16px); justify-content: center; margin-top: 18px; flex-wrap: wrap; }
  .dwg-rd-phero__thumb {
    border: 2px solid transparent; border-radius: 14px; overflow: hidden; padding: 0;
    background: #faf7f2; cursor: pointer; width: clamp(72px, 12vw, 120px); aspect-ratio: 1 / 1;
  }
  .dwg-rd-phero__thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .dwg-rd-phero__thumb.is-active { border-color: var(--rd-ph-btn-bg); }

  /* Bundles */
  .dwg-rd-phero__bundles { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin: 0 0 22px; max-width: 440px; }
  .dwg-rd-phero__bundle {
    text-align: left; cursor: pointer; background: #fff;
    border: 1.5px solid rgba(28,28,28,0.2); border-radius: 12px; padding: 16px 18px;
    display: flex; flex-direction: column; gap: 6px; transition: border-color .2s, box-shadow .2s;
  }
  .dwg-rd-phero__bundle.is-active { border-color: var(--rd-ph-btn-bg); box-shadow: 0 0 0 1px var(--rd-ph-btn-bg); }
  .dwg-rd-phero__bundle-name { font-family: 'Outfit', sans-serif; font-size: 0.95rem; color: rgba(28,28,28,0.7); }
  .dwg-rd-phero__bundle-price { font-family: 'Outfit', sans-serif; font-weight: 600; font-size: 1.25rem; color: var(--rd-ph-text); }

  .dwg-rd-phero__price-label { font-family: 'Manjari', sans-serif; color: rgba(28,28,28,0.5); margin: 0 0 4px; }
{% endstylesheet %}

<script>
  (function () {
    document.querySelectorAll('.dwg-rd-phero').forEach(function (root) {
      // ── Image gallery ──
      var stage = root.querySelector('[data-g-stage]');
      if (stage) {
        var slides = Array.prototype.slice.call(stage.querySelectorAll('.dwg-rd-phero__img'));
        var thumbs = Array.prototype.slice.call(root.querySelectorAll('[data-g-thumb]'));
        var gi = 0;
        function goTo(n) {
          if (!slides.length) return;
          gi = (n + slides.length) % slides.length;
          slides.forEach(function (s, i) { s.classList.toggle('is-active', i === gi); });
          thumbs.forEach(function (t, i) { t.classList.toggle('is-active', i === gi); });
        }
        var prev = root.querySelector('[data-g-prev]');
        var next = root.querySelector('[data-g-next]');
        if (prev) prev.addEventListener('click', function () { goTo(gi - 1); });
        if (next) next.addEventListener('click', function () { goTo(gi + 1); });
        thumbs.forEach(function (t) {
          t.addEventListener('click', function () { goTo(parseInt(t.getAttribute('data-g-thumb'), 10)); });
        });
      }

      // ── Bundle options (sets quantity + updates price) ──
      var bundles = root.querySelector('[data-bundles]');
      if (bundles) {
        var qtyHidden = root.querySelector('[data-qty-hidden]');
        var priceTarget = root.querySelector('[data-price-target]');
        bundles.querySelectorAll('.dwg-rd-phero__bundle').forEach(function (b) {
          b.addEventListener('click', function () {
            bundles.querySelectorAll('.dwg-rd-phero__bundle').forEach(function (x) { x.classList.remove('is-active'); });
            b.classList.add('is-active');
            if (qtyHidden) qtyHidden.value = b.getAttribute('data-bundle-qty') || '1';
            if (priceTarget) priceTarget.textContent = b.getAttribute('data-bundle-price') || priceTarget.textContent;
          });
        });
      }
    });
  })();
</script>

{% schema %}
{
  "name": "DWG RD: Product hero",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading (blank = product title)" },
    { "type": "text", "id": "eyebrow", "label": "Tagline", "default": "Heat Flavor, Gold Standard" },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Premium chilli oil crafted to elevate every meal with bold, unforgettable flavor.</p>" },
    { "type": "text", "id": "button_label", "label": "Add to cart label", "default": "Add to Cart" },
    { "type": "url", "id": "button_link", "label": "Button link (used when out of stock)" },
    { "type": "image_picker", "id": "image", "label": "Image (blank = design/product image)" },
    { "type": "checkbox", "id": "use_design_images", "label": "Use design product image", "info": "Show the Figma bottle/jar (mapped by product title) instead of the product's own photo.", "default": true },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#BD8C1E" },
    { "type": "color", "id": "eyebrow_color", "label": "Tagline", "default": "#B28100" },
    { "type": "color", "id": "text_color", "label": "Body text", "default": "#1C1C1C" },
    { "type": "color", "id": "button_background", "label": "Button", "default": "#A97E0C" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#FFFFFF" }
  ]
}
{% endschema %}
