{% comment %}
  DWG redesign — Product hero (PDP). Title + tagline + body + CTA on the
  left, product jar image on the right. Uses the product object; the CTA
  adds to cart. Remove from the product template to revert.
{% endcomment %}

{% liquid
  assign bg = section.settings.background | default: '#FFFFFF'
  assign heading_color = section.settings.heading_color | default: '#BD8C1E'
  assign eyebrow_color = section.settings.eyebrow_color | default: '#B28100'
  assign text_color = section.settings.text_color | default: '#1C1C1C'
  assign btn_bg = section.settings.button_background | default: '#A97E0C'
  assign btn_text = section.settings.button_text_color | default: '#FFFFFF'
  assign heading = section.settings.heading | default: product.title | default: 'African Chilli Oil'
%}

<section
  class="dwg-rd-phero"
  style="--rd-ph-bg: {{ bg }}; --rd-ph-heading: {{ heading_color }}; --rd-ph-eyebrow: {{ eyebrow_color }}; --rd-ph-text: {{ text_color }}; --rd-ph-btn-bg: {{ btn_bg }}; --rd-ph-btn-text: {{ btn_text }};"
>
  <div class="dwg-rd-phero__wrap page-width">
    <div class="dwg-rd-phero__content">
      <h1 class="dwg-rd-phero__heading">{{ heading }}</h1>
      {% if section.settings.eyebrow != blank %}
        <p class="dwg-rd-phero__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      {% if section.settings.body != blank %}
        <div class="dwg-rd-phero__body">{{ section.settings.body }}</div>
      {% endif %}
      {% if product != blank %}
        {% if product.price != blank %}
          <p class="dwg-rd-phero__price">
            {{ product.price | money }}
            {% if product.compare_at_price > product.price %}
              <s class="dwg-rd-phero__was">{{ product.compare_at_price | money }}</s>
            {% endif %}
          </p>
        {% endif %}

        {% form 'product', product, class: 'dwg-rd-phero__form', id: 'dwg-phero-form' %}
          {% if product.variants.size > 1 %}
            <label class="dwg-rd-phero__vh" for="dwg-phero-variant">Variant</label>
            <select id="dwg-phero-variant" name="id" class="dwg-rd-phero__variants">
              {% for v in product.variants %}
                <option value="{{ v.id }}" {% if v == product.selected_or_first_available_variant %}selected{% endif %} {% unless v.available %}disabled{% endunless %}>
                  {{ v.title }} · {{ v.price | money }}{% unless v.available %} (sold out){% endunless %}
                </option>
              {% endfor %}
            </select>
          {% else %}
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          {% endif %}

          <div class="dwg-rd-phero__purchase">
            <div class="dwg-rd-phero__qty" data-qty>
              <button type="button" class="dwg-rd-phero__qty-btn" data-qty-minus aria-label="Decrease quantity">&minus;</button>
              <input type="number" class="dwg-rd-phero__qty-input" name="quantity" value="1" min="1" inputmode="numeric" aria-label="Quantity">
              <button type="button" class="dwg-rd-phero__qty-btn" data-qty-plus aria-label="Increase quantity">&plus;</button>
            </div>
            <button type="submit" name="add" class="dwg-rd-phero__btn dwg-rd-phero__btn--add"{% unless product.available %} disabled{% endunless %}>
              {% if product.available %}{{ section.settings.button_label | default: 'Add to Cart' }}{% else %}Sold Out{% endif %}
            </button>
          </div>

          {% if product.available %}
            {{ form | payment_button }}
          {% endif %}
        {% endform %}
      {% else %}
        <a class="dwg-rd-phero__btn dwg-rd-phero__btn--add" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | default: 'Check Us Out' }}</a>
      {% endif %}
    </div>

    <div class="dwg-rd-phero__media">
      {% liquid
        assign design_img = ''
        if section.settings.use_design_images
          assign t = product.title | downcase
          if t contains 'jar'
            assign design_img = 'dwg-rd-shop-jar.png'
          elsif t contains '3 pack' or t contains '3-pack' or t contains 'triple' or t contains 'trio' or t contains 'three' or t contains 'bundle'
            assign design_img = 'dwg-rd-shop-trio.png'
          elsif t contains 'pack' or t contains 'double' or t contains 'duo' or t contains 'twin' or t contains '2 pack'
            assign design_img = 'dwg-rd-shop-pack.png'
          else
            assign design_img = 'dwg-rd-shop-bottle.png'
          endif
        endif
      %}
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 900 | image_tag: class: 'dwg-rd-phero__img', widths: '400, 600, 900', loading: 'eager', alt: heading }}
      {% elsif design_img != blank %}
        <img class="dwg-rd-phero__img" src="{{ design_img | asset_url }}" alt="{{ heading }}" width="600" height="800" loading="eager">
      {% elsif product.featured_image %}
        {{ product.featured_image | image_url: width: 900 | image_tag: class: 'dwg-rd-phero__img', widths: '400, 600, 900', loading: 'eager', alt: heading }}
      {% else %}
        <img class="dwg-rd-phero__img" src="{{ 'dwg-rd-shop-jar.png' | asset_url }}" alt="{{ heading }}" width="600" height="600" loading="eager">
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .dwg-rd-phero {
    background: var(--rd-ph-bg);
    padding-block: clamp(24px, 4vw, 56px);
  }

  .dwg-rd-phero__wrap {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(24px, 5vw, 56px);
    align-items: center;
  }

  @media screen and (min-width: 900px) {
    .dwg-rd-phero__wrap { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  }

  .dwg-rd-phero__heading {
    font-family: 'Outfit', sans-serif;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 0.98;
    font-size: clamp(2.25rem, 4.4vw, 3.75rem);
    color: var(--rd-ph-heading);
    margin: 0 0 22px;
  }

  .dwg-rd-phero__eyebrow {
    font-family: 'Inter', sans-serif;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-size: clamp(0.9rem, 1.4vw, 1.1rem);
    color: var(--rd-ph-eyebrow);
    margin: 0 0 18px;
  }

  .dwg-rd-phero__body {
    font-family: 'Manjari', sans-serif;
    font-size: clamp(1.05rem, 1.6vw, 1.3rem);
    line-height: 1.5;
    color: var(--rd-ph-text);
    max-width: 42ch;
    margin: 0 0 30px;
  }

  .dwg-rd-phero__form { margin: 0; }

  .dwg-rd-phero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0;
    cursor: pointer;
    font-family: 'Manjari', sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    font-size: clamp(0.9rem, 1.1vw, 1rem);
    padding: clamp(12px, 1.4vw, 15px) clamp(20px, 2.4vw, 30px);
    background: var(--rd-ph-btn-bg);
    color: var(--rd-ph-btn-text);
    text-decoration: none;
    transition: filter 0.2s ease;
  }

  .dwg-rd-phero__btn:hover { filter: brightness(1.08); }
  .dwg-rd-phero__btn:disabled { opacity: 0.5; cursor: not-allowed; }

  .dwg-rd-phero__price {
    font-family: 'Outfit', sans-serif;
    font-weight: 600;
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    color: var(--rd-ph-text);
    margin: 0 0 22px;
    display: flex;
    align-items: baseline;
    gap: 12px;
  }
  .dwg-rd-phero__was { color: rgba(28,28,28,0.45); font-weight: 400; font-size: 0.7em; }

  .dwg-rd-phero__variants {
    display: block;
    width: 100%;
    max-width: 340px;
    padding: 14px 16px;
    margin: 0 0 18px;
    border: 1.5px solid rgba(28, 28, 28, 0.25);
    border-radius: 8px;
    font-family: 'Outfit', sans-serif;
    font-size: 1rem;
    background: #fff;
  }

  /* Purchase controls sit in one balanced, capped-width column */
  .dwg-rd-phero__form { max-width: 440px; }

  .dwg-rd-phero__purchase {
    display: flex;
    align-items: stretch;
    gap: 12px;
    margin-bottom: 12px;
  }

  .dwg-rd-phero__qty {
    display: inline-flex;
    align-items: center;
    border: 1.5px solid rgba(28, 28, 28, 0.22);
    border-radius: 6px;
    overflow: hidden;
    flex: 0 0 auto;
  }
  .dwg-rd-phero__qty-btn {
    border: 0;
    background: none;
    cursor: pointer;
    width: 40px;
    align-self: stretch;
    font-size: 1.15rem;
    color: var(--rd-ph-text);
    font-family: 'Outfit', sans-serif;
  }
  .dwg-rd-phero__qty-input {
    width: 40px;
    border: 0;
    text-align: center;
    font-family: 'Outfit', sans-serif;
    font-size: 1rem;
    -moz-appearance: textfield;
  }
  .dwg-rd-phero__qty-input::-webkit-outer-spin-button,
  .dwg-rd-phero__qty-input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }

  .dwg-rd-phero__btn--add { flex: 1 1 auto; }

  /* Shopify dynamic checkout (Buy Now / Shop Pay) */
  .dwg-rd-phero__form .shopify-payment-button { margin-top: 0; }
  .dwg-rd-phero__form .shopify-payment-button__button--unbranded {
    background: #1c1c1c;
    border-radius: 6px;
    font-family: 'Manjari', sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    padding: 14px;
    min-height: 0;
  }

  .dwg-rd-phero__vh { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

  .dwg-rd-phero__media { display: flex; justify-content: center; align-items: center; }

  .dwg-rd-phero__img {
    width: 100%;
    max-width: 560px;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 20px 44px rgba(0, 0, 0, 0.16));
  }
{% endstylesheet %}

<script>
  (function () {
    document.querySelectorAll('.dwg-rd-phero__qty[data-qty]').forEach(function (wrap) {
      var input = wrap.querySelector('.dwg-rd-phero__qty-input');
      wrap.querySelector('[data-qty-minus]').addEventListener('click', function () {
        input.value = Math.max(1, (parseInt(input.value, 10) || 1) - 1);
      });
      wrap.querySelector('[data-qty-plus]').addEventListener('click', function () {
        input.value = (parseInt(input.value, 10) || 1) + 1;
      });
    });
  })();
</script>

{% schema %}
{
  "name": "DWG RD: Product hero",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading (blank = product title)" },
    { "type": "text", "id": "eyebrow", "label": "Tagline", "default": "Heat Flavor, Gold Standard" },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Premium chilli oil crafted to elevate every meal with bold, unforgettable flavor.</p>" },
    { "type": "text", "id": "button_label", "label": "Add to cart label", "default": "Add to Cart" },
    { "type": "url", "id": "button_link", "label": "Button link (used when out of stock)" },
    { "type": "image_picker", "id": "image", "label": "Image (blank = design/product image)" },
    { "type": "checkbox", "id": "use_design_images", "label": "Use design product image", "info": "Show the Figma bottle/jar (mapped by product title) instead of the product's own photo.", "default": true },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#BD8C1E" },
    { "type": "color", "id": "eyebrow_color", "label": "Tagline", "default": "#B28100" },
    { "type": "color", "id": "text_color", "label": "Body text", "default": "#1C1C1C" },
    { "type": "color", "id": "button_background", "label": "Button", "default": "#A97E0C" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#FFFFFF" }
  ]
}
{% endschema %}
