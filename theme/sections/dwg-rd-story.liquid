{% comment %}
  DWG redesign — Gold story banner: "More Coming From DWG" + founder card.
  Left = full-bleed image that cross-fades between images (like the hero).
  Remove this section to revert.
{% endcomment %}

{% liquid
  assign bg = section.settings.background | default: '#BD8C1E'
  assign text_color = section.settings.text_color | default: '#FFFFFF'
  assign btn_bg = section.settings.button_background | default: '#D7AF46'
  assign btn_text = section.settings.button_text_color | default: '#1C1C1C'
  assign speed = section.settings.autoplay_speed | default: 2
  assign speed_ms = speed | times: 1000
%}

<section
  class="dwg-rd-story"
  style="
    --rd-st-bg: {{ bg }};
    --rd-st-text: {{ text_color }};
    --rd-st-btn-bg: {{ btn_bg }};
    --rd-st-btn-text: {{ btn_text }};
  "
>
  <div class="dwg-rd-story__wrap">
    <div class="dwg-rd-story__media" data-story-media data-autoplay="{{ speed_ms }}">
      <div class="dwg-rd-story__track" data-story-track>
        <div class="dwg-rd-story__slide">
          {% if section.settings.image != blank %}
            {{ section.settings.image | image_url: width: 1200 | image_tag: class: 'dwg-rd-story__img', widths: '500, 800, 1200', loading: 'lazy', alt: 'DWG chilli oil' }}
          {% else %}
            <img class="dwg-rd-story__img" src="{{ 'dwg-rd-more-bottle.png' | asset_url }}" alt="DWG chilli oil" width="820" height="1024" loading="lazy">
          {% endif %}
        </div>
        <div class="dwg-rd-story__slide">
          {% if section.settings.image_2 != blank %}
            {{ section.settings.image_2 | image_url: width: 1200 | image_tag: class: 'dwg-rd-story__img', widths: '500, 800, 1200', loading: 'lazy', alt: 'DWG founder' }}
          {% else %}
            <img class="dwg-rd-story__img" src="{{ 'dwg-rd-story-chef.jpg' | asset_url }}" alt="DWG founder" width="933" height="1400" loading="lazy">
          {% endif %}
        </div>
      </div>
    </div>

    <div class="dwg-rd-story__content">
      {% if section.settings.heading != blank %}
        <h2 class="dwg-rd-story__heading">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.subtext != blank %}
        <p class="dwg-rd-story__subtext">{{ section.settings.subtext }}</p>
      {% endif %}

      <div class="dwg-rd-story__card">
        {% if section.settings.card_heading != blank %}
          <h3 class="dwg-rd-story__card-heading">{{ section.settings.card_heading }}</h3>
        {% endif %}
        {% if section.settings.card_body != blank %}
          <div class="dwg-rd-story__card-body">{{ section.settings.card_body }}</div>
        {% endif %}
        {% if section.settings.button_label != blank %}
          <a class="dwg-rd-story__btn" href="{{ section.settings.button_link | default: '#' }}">
            {{ section.settings.button_label }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .dwg-rd-story {
    background-color: var(--rd-st-bg);
    color: var(--rd-st-text);
    overflow: hidden;
  }

  .dwg-rd-story__wrap {
    display: grid;
    grid-template-columns: 1fr;
  }

  /* Media clips; the inner track slides (parent clips, child transforms) */
  .dwg-rd-story__media {
    position: relative;
    min-height: clamp(260px, 42vw, 380px);
    overflow: hidden;
    background: var(--rd-st-bg);
  }

  .dwg-rd-story__track {
    display: flex;
    flex-wrap: nowrap;
    height: 100%;
    transition: transform 1.2s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: transform;
  }

  .dwg-rd-story__slide {
    flex: 0 0 100%;
    height: 100%;
  }

  /* Cover = image fills its space; anchor to top so heads aren't cut */
  .dwg-rd-story__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
  }

  .dwg-rd-story__content {
    padding: clamp(24px, 4.5vw, 52px) clamp(20px, 5vw, 48px);
  }

  @media screen and (min-width: 900px) {
    .dwg-rd-story__wrap {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
      align-items: center;
    }
    /* Short fixed media height so the section stays compact */
    .dwg-rd-story__media { min-height: 0; height: clamp(300px, 32vw, 400px); }
    .dwg-rd-story__content {
      padding-block: clamp(14px, 2vw, 26px);
      padding-right: max(clamp(20px, 5vw, 48px), calc((100% - var(--dwg-page-max, 1360px)) / 2 + 48px));
      padding-left: clamp(28px, 3.5vw, 56px);
      align-self: center;
    }
  }

  .dwg-rd-story__heading {
    font-family: 'Outfit', sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    font-size: clamp(1.4rem, 2.6vw, 2rem);
    line-height: 1.05;
    margin: 0 0 8px;
    color: var(--rd-st-text);
  }

  .dwg-rd-story__subtext {
    font-family: 'Outfit', sans-serif;
    font-weight: 400;
    font-size: clamp(0.92rem, 1.2vw, 1.02rem);
    line-height: 1.4;
    margin: 0 0 14px;
    max-width: 48ch;
    opacity: 0.95;
  }

  .dwg-rd-story__card {
    border: 1px solid rgba(255, 255, 255, 0.7);
    border-radius: 18px;
    padding: clamp(14px, 1.8vw, 22px);
  }

  .dwg-rd-story__card-heading {
    font-family: 'Outfit', sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    font-size: clamp(1.1rem, 1.9vw, 1.4rem);
    line-height: 1.12;
    margin: 0 0 8px;
    color: var(--rd-st-text);
  }

  .dwg-rd-story__card-body {
    font-family: 'Outfit', sans-serif;
    font-weight: 300;
    font-size: clamp(0.88rem, 1.15vw, 0.98rem);
    line-height: 1.4;
    margin: 0 0 14px;
  }

  .dwg-rd-story__card-body p { margin: 0; }

  .dwg-rd-story__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: 'Manjari', sans-serif;
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 10px 26px;
    background: var(--rd-st-btn-bg);
    color: var(--rd-st-btn-text);
    transition: filter 0.2s ease;
  }

  .dwg-rd-story__btn:hover { filter: brightness(1.06); }

  /* Mobile: image fills the media band */
  @media screen and (max-width: 899px) {
    .dwg-rd-story__media {
      min-height: 0;
      aspect-ratio: 4 / 5;
      background: var(--rd-st-bg);
    }
    .dwg-rd-story__img { object-fit: cover; object-position: center top; }
  }
{% endstylesheet %}

<script>
  (function () {
    var root = document.currentScript.previousElementSibling;
    while (root && !(root.classList && root.classList.contains('dwg-rd-story'))) {
      root = root.previousElementSibling;
    }
    if (!root) return;
    var media = root.querySelector('[data-story-media]');
    var track = root.querySelector('[data-story-track]');
    if (!media || !track) return;
    var slides = Array.prototype.slice.call(track.querySelectorAll('.dwg-rd-story__slide'));
    if (slides.length < 2) return;

    var i = 0;
    var delay = parseInt(media.getAttribute('data-autoplay'), 10) || 4000;
    if (delay < 3500) delay = 4000;
    function tick() {
      i = (i + 1) % slides.length;
      track.style.transform = 'translateX(' + (-i * 100) + '%)';
    }
    setInterval(tick, delay);
  })();
</script>

{% schema %}
{
  "name": "DWG RD: Story banner",
  "tag": "section",
  "class": "section--dwg-rd-story",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image 1 (bottle)" },
    { "type": "image_picker", "id": "image_2", "label": "Image 2 (founder)" },
    { "type": "range", "id": "autoplay_speed", "label": "Image change speed (seconds)", "min": 1, "max": 8, "step": 0.5, "default": 2 },
    { "type": "text", "id": "heading", "label": "Heading", "default": "More Coming From DWG" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "More products, more partnerships and more sections on our website. Constantly evolving!" },
    { "type": "header", "content": "Founder card" },
    { "type": "text", "id": "card_heading", "label": "Card heading", "default": "British by birth. Nigerian by blood." },
    { "type": "richtext", "id": "card_body", "label": "Card body", "default": "<p>I'm Wura, founder and chef behind Dining With Gold. In Yoruba, Wura means Gold. So when you eat with DWG, you're dining at my table wherever in the world you are. And at my table, the food is always bold, always flavourful, and always made with love.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Read About Page" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background", "label": "Background", "default": "#BD8C1E" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#FFFFFF" },
    { "type": "color", "id": "button_background", "label": "Button background", "default": "#D7AF46" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#1C1C1C" }
  ],
  "presets": [{ "name": "DWG RD: Story banner" }]
}
{% endschema %}
