{%- comment -%}
  DWG SEO structured data (JSON-LD), centralised.
  - Organization (site-wide): name, url, logo, description, email, sameAs
  - WebSite + SearchAction (home): enables the sitelinks search box
  - Product + Offer + Brand (product pages): restored after the custom PDP
  - BreadcrumbList (product + collection): rich-result breadcrumbs
  Rendered from layout/theme.liquid. Remove that render to revert.
{%- endcomment -%}

{%- liquid
  assign brand_name = shop.name
  assign home = request.origin
  assign brand_desc = shop.description | default: 'Dining With Gold — premium African chilli oil. Bold, fiery flavour crafted to elevate every meal.'
-%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": {{ brand_name | json }},
  "url": {{ home | json }},
  {% if settings.logo %}"logo": {{ settings.logo | image_url: width: 512 | prepend: "https:" | json }},{% endif %}
  "description": {{ brand_desc | strip_html | json }},
  "email": "diningwithgold@outlook.com",
  "sameAs": [
    "https://www.instagram.com/diningwithgold/"
    {%- if settings.social_facebook_link != blank %}, {{ settings.social_facebook_link | json }}{% endif -%}
    {%- if settings.social_tiktok_link != blank %}, {{ settings.social_tiktok_link | json }}{% endif -%}
    {%- if settings.social_youtube_link != blank %}, {{ settings.social_youtube_link | json }}{% endif -%}
    {%- if settings.social_twitter_link != blank %}, {{ settings.social_twitter_link | json }}{% endif -%}
  ]
}
</script>

{%- if request.page_type == 'index' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": {{ brand_name | json }},
  "url": {{ home | json }},
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": {{ home | append: '/search?q={search_term_string}' | json }}
    },
    "query-input": "required name=search_term_string"
  }
}
</script>
{%- endif -%}

{%- if request.page_type == 'product' and product -%}
  {%- assign v = product.selected_or_first_available_variant -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ product.title | json }},
  "description": {{ product.description | strip_html | truncate: 500 | json }},
  "image": [
    {%- for img in product.images limit: 5 -%}
      {{ img | image_url: width: 1200 | prepend: 'https:' | json }}{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ],
  "brand": { "@type": "Brand", "name": {{ brand_name | json }} },
  "sku": {{ v.sku | default: product.id | json }},
  "url": {{ home | append: product.url | json }},
  "offers": {
    "@type": "Offer",
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "price": {{ v.price | money_without_currency | strip_html | json }},
    "availability": "https://schema.org/{% if product.available %}InStock{% else %}OutOfStock{% endif %}",
    "url": {{ home | append: product.url | json }},
    "seller": { "@type": "Organization", "name": {{ brand_name | json }} }
  }
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ home | json }} },
    { "@type": "ListItem", "position": 2, "name": "Shop", "item": {{ home | append: '/collections/all' | json }} },
    { "@type": "ListItem", "position": 3, "name": {{ product.title | json }}, "item": {{ home | append: product.url | json }} }
  ]
}
</script>
{%- endif -%}

{%- if request.page_type == 'collection' and collection -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ home | json }} },
    { "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ home | append: collection.url | json }} }
  ]
}
</script>
{%- endif -%}
