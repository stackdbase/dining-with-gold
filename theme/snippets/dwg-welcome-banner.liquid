{%- doc -%}
  DWG newsletter signup modal — "Unlock 10% Off Your First Order".
  Matches the redesign: white panel, Outfit type, gold headings, chef image
  left, Email + NO THANKS / SIGN UP. Rendered site-wide from layout/theme.liquid.
  Shows after a short delay; hidden permanently after signup, and for a few
  days after a dismissal.

  @example
  {% render 'dwg-welcome-banner' %}
{%- enddoc -%}

{%- liquid
  assign popup_image = 'dwg-rd-popup-chef.jpg' | asset_url
  assign gold = '#A67C1E'
  assign just_submitted = false
-%}

{%- capture form_html -%}
  {%- form 'customer', class: 'dwg-pop__form' -%}
    {%- if form.posted_successfully? -%}{%- assign just_submitted = true -%}{%- endif -%}
    <input type="hidden" name="contact[tags]" value="newsletter">
    <label for="dwg-pop-email" class="dwg-pop__vh">Email Address</label>
    <input id="dwg-pop-email" class="dwg-pop__input" type="email" name="contact[email]" placeholder="Email Address" autocomplete="email" autocorrect="off" autocapitalize="off" required>
    {%- if form.errors -%}
      <p class="dwg-pop__err" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
    {%- endif -%}
    <div class="dwg-pop__actions">
      <button type="button" class="dwg-pop__no" data-dwg-close>NO THANKS</button>
      <button type="submit" class="dwg-pop__submit">SIGN UP</button>
    </div>
  {%- endform -%}
{%- endcapture -%}

<aside class="dwg-pop" data-dwg-popup{% if just_submitted %} data-dwg-open-now{% endif %} aria-hidden="true">
  <div class="dwg-pop__overlay" data-dwg-close></div>
  <div class="dwg-pop__dialog" role="dialog" aria-modal="true" aria-label="Sign up for 10% off">
    <div class="dwg-pop__media" style="background-image: url('{{ popup_image }}');"></div>
    <div class="dwg-pop__panel">
      <div class="dwg-pop__top">
        <span class="dwg-pop__brand">Dining With Gold</span>
        <button type="button" class="dwg-pop__x" data-dwg-close aria-label="Close">&times;</button>
      </div>

      {%- if just_submitted -%}
        <h2 class="dwg-pop__title">You're In!</h2>
        <p class="dwg-pop__sub">Check your inbox for your 10% off code.</p>
      {%- else -%}
        <h2 class="dwg-pop__title">Unlock 10% Off<br>Your First Order</h2>
        <p class="dwg-pop__sub">When you sign up to our list</p>
        <p class="dwg-pop__legal">By subscribing, you agree to receive recurring marketing emails from Dining With Gold and accept our <a href="/policies/privacy-policy">Privacy Policy</a>. Consent is not a condition of any purchase. You can opt out at any time.</p>
        {{ form_html }}
      {%- endif -%}
    </div>
  </div>
</aside>

{% stylesheet %}
  .dwg-pop {
    position: fixed;
    inset: 0;
    z-index: 9998;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }
  .dwg-pop.is-visible { opacity: 1; visibility: visible; pointer-events: auto; }

  .dwg-pop__overlay { position: absolute; inset: 0; background: rgba(20, 16, 8, 0.55); }

  .dwg-pop__dialog {
    position: relative;
    display: grid;
    grid-template-columns: 43% 1fr;
    width: min(960px, 100%);
    max-height: calc(100vh - 40px);
    background: #ffffff;
    border-radius: 4px;
    overflow: hidden;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.3);
    transform: translateY(14px) scale(0.99);
    transition: transform 0.32s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .dwg-pop.is-visible .dwg-pop__dialog { transform: none; }

  .dwg-pop__media {
    background-size: cover;
    background-position: center top;
    background-repeat: no-repeat;
    min-height: 100%;
  }

  .dwg-pop__panel {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(28px, 3.4vw, 52px);
    overflow-y: auto;
  }

  .dwg-pop__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: clamp(20px, 4vw, 44px);
  }

  .dwg-pop__brand {
    font-family: 'Outfit', sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.95rem;
    color: #A67C1E;
  }

  .dwg-pop__x {
    border: 0;
    background: none;
    cursor: pointer;
    color: #A67C1E;
    font-size: 1.9rem;
    line-height: 1;
    font-weight: 700;
    padding: 0 4px;
  }

  .dwg-pop__title {
    font-family: 'Outfit', sans-serif;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 1.02;
    font-size: clamp(1.9rem, 3vw, 2.9rem);
    color: #A67C1E;
    margin: 0 0 18px;
  }

  .dwg-pop__sub {
    font-family: 'Outfit', sans-serif;
    font-weight: 700;
    font-size: clamp(1rem, 1.4vw, 1.2rem);
    color: #A67C1E;
    margin: 0 0 26px;
  }

  .dwg-pop__legal {
    font-family: 'Outfit', sans-serif;
    font-weight: 400;
    font-size: 0.95rem;
    line-height: 1.5;
    color: #2a2a2a;
    margin: 0 0 26px;
  }
  .dwg-pop__legal a { color: #2a2a2a; text-decoration: underline; }

  .dwg-pop__form { margin: 0; }

  .dwg-pop__input {
    width: 100%;
    box-sizing: border-box;
    border: 1.5px solid #1c1c1c;
    border-radius: 10px;
    padding: 18px 20px;
    font-family: 'Outfit', sans-serif;
    font-size: 1rem;
    color: #1c1c1c;
    background: #fff;
    margin-bottom: 22px;
  }
  .dwg-pop__input::placeholder { color: #6b6b6b; }
  .dwg-pop__input:focus { outline: 2px solid #A67C1E; outline-offset: -1px; }

  .dwg-pop__err { color: #b3261e; font-family: 'Outfit', sans-serif; font-size: 0.9rem; margin: -12px 0 16px; }

  .dwg-pop__actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .dwg-pop__no {
    border: 0;
    background: none;
    cursor: pointer;
    font-family: 'Outfit', sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 1rem;
    color: #A67C1E;
    padding: 0;
  }

  .dwg-pop__submit {
    border: 0;
    cursor: pointer;
    font-family: 'Outfit', sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 1rem;
    color: #ffffff;
    background: #A67C1E;
    padding: 15px 40px;
    border-radius: 2px;
    transition: filter 0.2s ease;
  }
  .dwg-pop__submit:hover { filter: brightness(1.08); }

  .dwg-pop__vh { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  @media screen and (max-width: 749px) {
    .dwg-pop__dialog { grid-template-columns: 1fr; width: min(440px, 100%); }
    .dwg-pop__media { min-height: 180px; }
    .dwg-pop__top { margin-bottom: 18px; }
  }
{% endstylesheet %}

<script>
  (function () {
    var root = document.querySelector('[data-dwg-popup]');
    if (!root) return;
    var KEY = 'dwg_pop_v2';
    var DELAY = 2500;
    var DISMISS_DAYS = 5;

    function state() { try { return JSON.parse(localStorage.getItem(KEY)) || {}; } catch (e) { return {}; } }
    function save(o) { try { localStorage.setItem(KEY, JSON.stringify(o)); } catch (e) {} }

    function open() { root.classList.add('is-visible'); root.setAttribute('aria-hidden', 'false'); document.addEventListener('keydown', esc); }
    function close() { root.classList.remove('is-visible'); root.setAttribute('aria-hidden', 'true'); document.removeEventListener('keydown', esc); }
    function esc(e) { if (e.key === 'Escape') close(); }

    // Just signed up → open immediately to show confirmation, then remember permanently.
    if (root.hasAttribute('data-dwg-open-now')) {
      open();
      var s = state(); s.signed = true; save(s);
      return;
    }

    var s = state();
    if (s.signed) return;
    if (s.closedAt && (Date.now() - s.closedAt) < DISMISS_DAYS * 864e5) return;

    setTimeout(open, DELAY);

    root.querySelectorAll('[data-dwg-close]').forEach(function (el) {
      el.addEventListener('click', function () {
        close();
        var st = state(); st.closedAt = Date.now(); save(st);
      });
    });
  })();
</script>
